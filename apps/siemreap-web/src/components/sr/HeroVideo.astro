---
---
<video
  id="sr-hero-video"
  data-src="/video/hero-video.mp4"
  data-src-mobile="/video/hero-video-mobile.mp4"
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  aria-hidden="true"
  style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity 1.4s cubic-bezier(.22,.61,.36,1);"
></video>

<script>
  // Runs on first load and again after every client-side navigation,
  // since the page's DOM is swapped but hoisted scripts only run once.
  const init = () => {
    const video = document.getElementById('sr-hero-video') as HTMLVideoElement | null;
    if (!video || video.dataset.ready) return;
    video.dataset.ready = '1';
    // Phones get a portrait, much lighter clip.
    const phone = matchMedia('(max-width: 760px)').matches;
    video.src = (phone && video.dataset.srcMobile) || video.dataset.src || '';
    // Fade in only once the footage is actually moving, so the photo under
    // it dissolves straight into motion (no frozen first frame).
    const show = () => { video.style.opacity = '1'; };
    if (!video.paused && video.readyState >= 3) show();
    video.addEventListener('playing', show, { once: true });
    video.addEventListener('error', () => { video.remove(); });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

---
<video
  id="sr-hero-video"
  src="/video/hero-video.mp4"
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  aria-hidden="true"
  style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity .9s ease;"
></video>

<script>
  // Runs on first load and again after every client-side navigation,
  // since the page's DOM is swapped but hoisted scripts only run once.
  const init = () => {
    const video = document.getElementById('sr-hero-video') as HTMLVideoElement | null;
    if (!video || video.dataset.ready) return;
    video.dataset.ready = '1';
    const show = () => { video.style.opacity = '1'; };
    if (video.readyState >= 3) show();
    video.addEventListener('canplay', show);
    video.addEventListener('error', () => { video.remove(); });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

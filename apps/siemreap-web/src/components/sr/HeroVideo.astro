---
---
<video
  id="sr-hero-video"
  src="/video/hero-video.mp4"
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  aria-hidden="true"
  style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity .9s ease;"
></video>

<script>
  const video = document.getElementById('sr-hero-video') as HTMLVideoElement | null;
  if (video) {
    const isPhone = window.matchMedia('(max-width: 760px)').matches;
    if (isPhone) {
      video.remove();
    } else {
      video.addEventListener('canplay', () => { video.style.opacity = '1'; });
      video.addEventListener('error', () => { video.remove(); });
    }
  }
</script>

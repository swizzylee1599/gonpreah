---
import { srcset } from '../../lib/sr-img';
// The Campus Life opening: a pinned hero. "Campus Life" sits over the
// aerial; scrolling scrubs the turn clip down to the front of the building
// where "Welcome home." appears; scrolling on fades to black and the big
// statement comes up. Phones and browsers without the clip crossfade the two
// stills instead.
import { existsSync } from 'node:fs';
interface Props {
  aerial: string;
  front: string;
  video?: string;
  eyebrow?: string;
  title?: string;
  km?: string;
  welcome?: string;
  statement: string;
  sub?: string;
  photos?: { src: string; alt: string; pos?: string }[];
}
const {
  aerial, front, video = '/video/campus-orbit.mp4',
  eyebrow = 'YWAM Siem Reap', title = 'Campus Life', km = 'ជីវិតសហគមន៍', welcome = 'Welcome home.', statement, sub, photos = [],
} = Astro.props;
const hasVideo = existsSync('public' + video);
const small = (p: string) => p.replace(/\.webp$/, '-800.webp');
const mobileVideo = video.replace(/\.mp4$/, '-mobile.mp4');
const hasMobile = existsSync('public' + mobileVideo);
// A small preview of each clip (-lo) loads first so the turn works within a
// second or two; the sharp clip fades in over it once it has fully arrived.
const lo = (v: string) => v.replace(/\.mp4$/, '-lo.mp4');
const hasLo = existsSync('public' + lo(video));
const hasMobileLo = hasMobile && existsSync('public' + lo(mobileVideo));
---
<section class="dive-stack" aria-label={title}>
  <div class="dive-pin">
    <div class="dive-photo dive-aerial" style={`background-image:url(${aerial})`} data-small={small(aerial)}></div>
    <div class="dive-photo dive-front" style={`background-image:url(${front})`} data-small={small(front)}></div>
    {hasVideo && hasLo && <video class="dive-video" data-tier="lo" data-src={lo(video)} data-src-mobile={hasMobileLo ? lo(mobileVideo) : undefined} muted playsinline webkit-playsinline preload="none" aria-hidden="true"></video>}
    {hasVideo && <video class="dive-video" data-tier="hi" data-src={video} data-src-mobile={hasMobile ? mobileVideo : undefined} muted playsinline webkit-playsinline preload="none" aria-label="The campus, turning from above to its front"></video>}
    <div class="dive-scrim" aria-hidden="true"></div>

    <div class="wrap dive-head" data-stage="0">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="disp dive-h1">{title}</h1>
      {km && <p class="km" style="font-size:28px;margin:14px 0 0;color:#dcdcdc;">{km}</p>}
      <p class="muted dive-cue" aria-hidden="true">Scroll ↓</p>
    </div>

    <div class="wrap dive-welcome" data-stage="1" aria-hidden="true">
      <p class="eyebrow">The campus</p>
      <p class="disp dive-title">{welcome}</p>
    </div>

    <div class="dive-black" aria-hidden="true"></div>

    <div class="wrap dive-statement" data-stage="2">
      <p class="disp dive-statement-text">{statement}</p>
      {sub && <p class="body dive-statement-sub">{sub}</p>}
      {photos.length > 0 && (
        <div class="dive-photos">
          {photos.map((ph) => <img src={ph.src} srcset={srcset(ph.src)} sizes="(max-width: 760px) 100vw, 50vw" alt={ph.alt} decoding="async" style={ph.pos ? `object-position:${ph.pos}` : undefined} />)}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // Downloads are kept per file for the life of the page, so when the
  // script starts again (page-load fires after the first run, and on every
  // visit back) it picks up the download already under way, not a new one.
  const blobs = new Map<string, Promise<string>>();
  let ctrl: AbortController | null = null;
  const init = () => {
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const stack = document.querySelector<HTMLElement>('.dive-stack');
    if (!stack) return;
    const pin = stack.querySelector<HTMLElement>('.dive-pin')!;
    const aerial = stack.querySelector<HTMLElement>('.dive-aerial')!;
    const front = stack.querySelector<HTMLElement>('.dive-front')!;
    const black = stack.querySelector<HTMLElement>('.dive-black')!;
    const scrim = stack.querySelector<HTMLElement>('.dive-scrim')!;
    const head = stack.querySelector<HTMLElement>('.dive-head')!;
    const welcome = stack.querySelector<HTMLElement>('.dive-welcome')!;
    const statement = stack.querySelector<HTMLElement>('.dive-statement')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { stack.classList.add('is-static'); return; }
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => t * t * (3 - 2 * t);

    // The clips. Each one is downloaded whole into memory before it is used,
    // so scrolling can never seek into a part that has not arrived yet: that
    // is what used to freeze the turn on a slow connection. The small preview
    // comes first and takes over from the stills as soon as it is here; the
    // sharp clip follows and fades in over it. Phones get portrait clips.
    // With Data Saver on, only the preview is fetched.
    type Clip = { el: HTMLVideoElement; tier: string; ready: boolean; primed: boolean; priming: boolean; seeking: boolean; latest: number; dirty: boolean };
    const phone = matchMedia('(max-width: 760px)').matches;
    const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    let clips: Clip[] = [...stack.querySelectorAll<HTMLVideoElement>('.dive-video')].map((el) => ({ el, tier: el.dataset.tier || 'hi', ready: false, primed: false, priming: false, seeking: false, latest: 0, dirty: false }));
    if (saveData && clips.some((c) => c.tier === 'lo')) clips = clips.filter((c) => { if (c.tier === 'hi') { c.el.remove(); return false; } return true; });
    let active: Clip | null = null;   // the clip on screen
    let incoming: Clip | null = null; // the sharp clip, lining up before it takes over
    let turnNow = 0;

    const seekTo = (c: Clip, t: number) => {
      c.latest = t; c.dirty = true;
      if (c.seeking) return;
      c.seeking = true; c.dirty = false;
      // Exact seeks, not fastSeek: fastSeek snaps to keyframes and the turn stutters.
      c.el.currentTime = t;
    };
    const target = (c: Clip) => turnNow * (c.el.duration || 0) * 0.985;
    // iOS only paints seeks once a clip has played, so play it, then pause it.
    // Nothing else ever plays the clips: the scroll stays in charge.
    const prime = (c: Clip) => {
      if (c.primed || c.priming) return;
      const p = c.el.play();
      if (!p || !p.then) { c.primed = true; return; }
      c.priming = true;
      p.then(() => { c.primed = true; c.el.pause(); onReady(c); }).catch(() => {}).finally(() => { c.priming = false; });
    };
    const onReady = (c: Clip) => {
      if (!c.ready || !c.el.duration) return;
      if (c.tier === 'hi') {
        if (active === c || incoming === c) return;
        // Line the sharp clip up on the current frame, then swap on its first paint.
        incoming = c;
        seekTo(c, target(c));
      } else if (!active) {
        active = c;
      }
      onScroll();
    };
    const load = async (c: Clip) => {
      const src = (phone && c.el.dataset.srcMobile) || c.el.dataset.src || '';
      let job = blobs.get(src);
      if (!job) {
        job = fetch(src).then((res) => { if (!res.ok) throw new Error(String(res.status)); return res.blob(); }).then((b) => URL.createObjectURL(b));
        blobs.set(src, job);
        job.catch(() => blobs.delete(src));
      }
      try {
        const url = await job;
        if (signal.aborted) return;
        c.el.src = url;
      } catch {
        if (signal.aborted) return;
        // If the download fails, let the browser stream it the usual way.
        c.el.preload = 'auto';
        c.el.src = src;
      }
      c.el.load();
    };
    clips.forEach((c) => {
      c.el.addEventListener('loadeddata', () => { c.ready = true; prime(c); onReady(c); }, { signal });
      c.el.addEventListener('seeked', () => {
        c.seeking = false;
        if (c === incoming) { incoming = null; active = c; clips.forEach((o) => { if (o !== c) o.el.style.opacity = '0'; }); onScroll(); return; }
        if (c.dirty) seekTo(c, c.latest);
      }, { signal });
      c.el.addEventListener('error', () => {
        if (active === c) active = null;
        if (incoming === c) incoming = null;
        c.el.remove(); clips = clips.filter((o) => o !== c); onScroll();
      }, { once: true, signal });
    });
    // When autoplay is blocked (Low Power Mode, data saver), the first touch
    // counts as a gesture, so iOS lets the clips be primed then.
    const unlock = () => clips.forEach((c) => { if (c.ready && !c.primed) prime(c); });
    for (const ev of ['touchstart', 'touchend', 'click']) window.addEventListener(ev, unlock, { passive: true, signal });
    // Start as soon as the section is within a screen of view: preview first,
    // then the sharp clip, one after the other so the preview is never slowed.
    if (clips.length) {
      const near = new IntersectionObserver(async (en) => {
        if (!en[0].isIntersecting) return;
        near.disconnect();
        for (const c of [...clips].sort((x, y) => (x.tier === 'lo' ? -1 : 1) - (y.tier === 'lo' ? -1 : 1))) {
          if (signal.aborted) return;
          await load(c);
          if (c.tier === 'lo') await new Promise<void>((r) => { if (c.ready) r(); else c.el.addEventListener('loadeddata', () => r(), { once: true, signal }); c.el.addEventListener('error', () => r(), { once: true, signal }); });
        }
      }, { rootMargin: '100% 0px' });
      near.observe(stack); signal.addEventListener('abort', () => near.disconnect());
    }

    // Stages: title holds 0–.12 and fades by .3; the turn runs .1–.6; welcome
    // .55–.78; the front dims from .68; statement .76–.9 over the building.
    // The sequence follows the finger 1:1; easing toward the scroll position
    // made it trail behind and felt laggy on phones.
    const measure = () => {
      const rect = stack.getBoundingClientRect();
      const scrollable = rect.height - pin.offsetHeight;
      return scrollable <= 0 ? 0 : clamp01(-rect.top / scrollable);
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const p = measure();

      const turn = clamp01((p - 0.08) / 0.44);
      turnNow = turn;
      if (incoming) seekTo(incoming, target(incoming));
      if (active && active.el.duration) {
        if (!active.el.paused) active.el.pause();
        active.el.style.opacity = '1';
        aerial.style.opacity = String(1 - clamp01(turn * 8));
        aerial.style.transform = '';
        front.style.opacity = '0';
        front.style.transform = '';
        seekTo(active, target(active));
      } else {
        // Until a clip is here (or if none can play), the stills stand in.
        clips.forEach((c) => { c.el.style.opacity = '0'; });
        // Stills: push in on the aerial, a short crossfade, then the front settles.
        const x = ease(clamp01((turn - 0.5) / 0.22));
        aerial.style.opacity = String(1 - x);
        aerial.style.transform = `translate3d(0,0,0) scale(${(1 + ease(clamp01(turn / 0.72)) * 0.22).toFixed(4)})`;
        front.style.opacity = String(x);
        front.style.transform = `translate3d(0,0,0) scale(${(1.12 - 0.12 * ease(clamp01((turn - 0.5) / 0.5))).toFixed(4)})`;
      }
      scrim.style.opacity = String(0.55 - 0.2 * turn);

      const headOut = clamp01((p - 0.1) / 0.14);
      head.style.opacity = String(1 - headOut);
      head.style.transform = `translateY(calc(-50% - ${(headOut * 40).toFixed(1)}px))`;
      head.style.pointerEvents = headOut > 0.9 ? 'none' : '';

      const wIn = clamp01((p - 0.46) / 0.1);
      const wOut = clamp01((p - 0.58) / 0.07);
      welcome.style.opacity = String(ease(wIn) * (1 - wOut));
      welcome.style.transform = `translateY(${((1 - ease(wIn)) * 24).toFixed(1)}px)`;

      // Dim the front of the campus under the statement rather than going to black.
      const dim = clamp01((p - 0.56) / 0.12);
      black.style.opacity = String(0.62 * ease(dim));

      const sIn = clamp01((p - 0.62) / 0.1);
      statement.style.opacity = String(ease(sIn));
      statement.style.transform = `translateY(calc(-50% + ${((1 - ease(sIn)) * 30).toFixed(1)}px)) scale(${(0.96 + 0.04 * ease(sIn)).toFixed(3)})`;
      const pIn = clamp01((p - 0.68) / 0.1);
      statement.querySelectorAll<HTMLElement>('.dive-photos img').forEach((img, i) => {
        const k = clamp01((pIn - i * 0.12) / 0.6);
        img.style.opacity = String(ease(k));
        img.style.transform = `translateY(${((1 - ease(k)) * 24).toFixed(1)}px) rotate(${((i % 2 ? 1 : -1) * (1 - ease(k)) * 4).toFixed(2)}deg)`;
      });
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { signal });
    update();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import PhotoSlot from './PhotoSlot.astro';

interface Props {
  items: { src?: string; alt?: string; label?: string }[];
  label: string;
  duration?: number;
  reverse?: boolean;
}
const { items, label, duration = 40, reverse = false } = Astro.props;
---
<div class="gallery" role="group" aria-label={label} style={`--gallery-duration:${duration}s`}>
  <div class:list={['gallery-track', { 'gallery-track--reverse': reverse }]}>
    {[0, 1].map((copy) => (
      <div class="gallery-set" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <div class="gallery-item">
            {item.src
              ? <img src={item.src} alt={item.alt ?? ''} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" />
              : <PhotoSlot label={item.label ?? 'Drop a photo'} radius={0} />}
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

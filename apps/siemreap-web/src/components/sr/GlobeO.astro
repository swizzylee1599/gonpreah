---
// The letter "O" drawn as a slowly spinning globe. Meridians scroll
// sideways behind a circular clip with edge shading; latitude rings stay
// put, as they would on a real spinning globe.
const MERIDIANS = [-16, 6, 28, 50, 72, 94, 116];
---
<svg class="globe-o" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="globe-o-clip"><circle cx="50" cy="50" r="44" /></clipPath>
    <linearGradient id="globe-o-shade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".12" />
      <stop offset=".5" stop-color="#fff" stop-opacity="1" />
      <stop offset="1" stop-color="#fff" stop-opacity=".12" />
    </linearGradient>
    <mask id="globe-o-mask"><rect x="0" y="0" width="100" height="100" fill="url(#globe-o-shade)" /></mask>
  </defs>
  <g clip-path="url(#globe-o-clip)" fill="none" stroke="currentColor" stroke-linecap="round">
    <g class="globe-o-spin" mask="url(#globe-o-mask)" stroke-width="2.6">
      {MERIDIANS.map((x) => <line x1={x} y1="0" x2={x} y2="100" />)}
    </g>
    <g stroke-width="3.2" opacity=".85">
      <line x1="0" y1="50" x2="100" y2="50" />
      <ellipse cx="50" cy="50" rx="60" ry="26" />
    </g>
  </g>
  <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="5.5" />
</svg>

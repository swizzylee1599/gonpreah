---
// The letter "O" drawn as a slowly turning Earth. A flat land map (two
// copies, end to end) scrolls sideways behind a circular clip with
// edge shading, which reads as the globe rotating.
const MAP_W = 176;
const MAP_H = 88;
const MAP_X = 6;
const MAP_Y = 6;
---
<svg class="globe-o" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="globe-o-clip"><circle cx="50" cy="50" r="44" /></clipPath>
    <linearGradient id="globe-o-shade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".18" />
      <stop offset=".5" stop-color="#fff" stop-opacity="1" />
      <stop offset="1" stop-color="#fff" stop-opacity=".18" />
    </linearGradient>
    <mask id="globe-o-mask"><rect x="0" y="0" width="100" height="100" fill="url(#globe-o-shade)" /></mask>
  </defs>
  <circle cx="50" cy="50" r="44" fill="currentColor" opacity=".1" />
  <g clip-path="url(#globe-o-clip)" mask="url(#globe-o-mask)">
    <g class="globe-o-spin">
      <image href="/images/earth-land.svg" x={MAP_X} y={MAP_Y} width={MAP_W} height={MAP_H} />
      <image href="/images/earth-land.svg" x={MAP_X + MAP_W} y={MAP_Y} width={MAP_W} height={MAP_H} />
    </g>
  </g>
  <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="5.5" />
</svg>

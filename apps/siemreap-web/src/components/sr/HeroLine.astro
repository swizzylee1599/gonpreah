---
const HERO_PAIRS: [string, string][] = [
  ['Heart', 'ដួងចិត្ត'], ['for', 'សម្រាប់'], ['Cambodia,', 'កម្ពុជា'],
  ['vision', 'ចក្ខុវិស័យ'], ['for', 'សម្រាប់'], ['the world', 'ពិភពលោក'],
];
const BREAK_AFTER = new Set([1, 2, 4]);
---
<h1 class="disp hstack hline" style="margin:20px 0 0;font-size:clamp(44px,7vw,96px);font-weight:500;line-height:1.16;letter-spacing:.03em;max-width:16ch;pointer-events:auto;">
  {HERO_PAIRS.map(([en, km], i) => (
    <>
      <span class="hpair" transition:name={`page-title-w${i}`} style={i === 5 ? 'color:var(--sr-pink);' : undefined}>
        <span class="hswap henw">
          <span class="hw"><i class={i % 2 === 0 ? 'hw-a' : 'hw-b'} style={`--d:${(0.075 * i + 0.12).toFixed(3)}s`}>{en}</i></span>
        </span>
        <span class="hswap hkmw km" aria-hidden="true" style="font-size:.86em;letter-spacing:-0.01em;">{km}</span>
        {i === 5 && (
          <svg class="planefly" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" style="position:absolute;top:-6px;right:-4px;">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2.5 1.5V22l4-1 4 1v-1.5L13 19v-5.5l8 2.5z" fill="#fff" />
          </svg>
        )}
      </span>{' '}
      {BREAK_AFTER.has(i) && <br class="hero-break" />}
    </>
  ))}
</h1>

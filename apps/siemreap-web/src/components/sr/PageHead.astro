---
import HeroVideo from './HeroVideo.astro';
import { srcset } from '../../lib/sr-img';
interface Props {
  eyebrow?: string;
  km?: string;
  lead?: string;
  /** false hides the short line under the title. */
  rule?: boolean;
  /** Play the home page's hero video over the photo (the photo shows until it can play). */
  video?: boolean;
  /** Shared page-transition name: a photo elsewhere with the same name grows into this one. */
  vt?: string;
  title: string;
  highlight?: string;
  photo?: string;
  photoAlt?: string;
  full?: boolean;
  photoPos?: string;
  center?: boolean;
  mobileFull?: boolean;
  long?: boolean;
  /** Extra-large title, for a header that is just the title over a photo. */
  big?: boolean;
  /** Extra class on the section, for one-off tweaks. */
  cls?: string;
}
const { eyebrow, km, lead, rule = true, video = false, vt, title, highlight, photo, photoAlt = '', full = false, photoPos, center = false, mobileFull = false, long = false, big = false, cls } = Astro.props;
const words = title.split(' ');
const highlightCount = highlight ? highlight.split(' ').length : 0;
---
<section class:list={['pagehead', cls, { 'pagehead--photo': !!photo, 'pagehead--full': full, 'pagehead--center': center, 'pagehead--mfull': mobileFull, 'pagehead--long': long, 'pagehead--video': video }]} style={photo ? undefined : 'padding:90px 0 0;'}>
  {photo && (
    <>
      <img class:list={['pagehead-photo', { 'pagehead-photo--vt': vt }]} src={photo} srcset={srcset(photo)} sizes="(max-width: 760px) 100vw, 50vw" alt={photoAlt} loading="eager" decoding="async" style={[photoPos && `object-position:${photoPos}`, vt && `view-transition-name:${vt}`].filter(Boolean).join(';') || undefined} />
      {video && <HeroVideo />}
      <div class="pagehead-scrim"></div>
    </>
  )}
  <div class="wrap" style="position:relative;">
    {eyebrow && <p class="eyebrow" style="margin:0 0 20px;">{eyebrow}</p>}
    <h1 class="disp" style={`margin:0;font-size:${big ? 'clamp(62px,11vw,150px)' : 'clamp(40px,6vw,78px)'};font-weight:500;line-height:${big ? '.95' : '1.06'};max-width:18ch;`}>
      {words.map((word, i) => (
        <>
          <span
            class="pt-word"
            transition:name={`page-title-w${i}`}
            style={i >= words.length - highlightCount ? 'color:var(--sr-pink);' : undefined}
          >{word}</span>{' '}
        </>
      ))}
    </h1>
    {km && <p class="km" style="font-size:28px;margin:18px 0 0;color:#dcdcdc;">{km}</p>}
    {rule && (km || lead) && <span class="rule" style="margin:30px 0 0;"></span>}
    {lead && <p class="body" style="margin:28px 0 0;max-width:58ch;font-size:19px;">{lead}</p>}
    {full && <p class="pagehead-cue muted" aria-hidden="true">Scroll ↓</p>}
  </div>
</section>

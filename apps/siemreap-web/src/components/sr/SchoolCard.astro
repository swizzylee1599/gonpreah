---
import PhotoSlot from './PhotoSlot.astro';

interface Props {
  name: string;
  abbr: string;
  body: string;
  when: string;
  photo?: string;
  href?: string;
}
const { name, abbr, body, when, photo, href = '/schools' } = Astro.props;
---
<a class="schoolcard" href={href}>
  <span class="schoolcard-photo" style="display:block;position:relative;">
    {photo
      ? <img src={photo} alt="" loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" />
      : <PhotoSlot label={`Drop a photo — ${name}`} radius={0} />}
  </span>
  <span class="schoolcard-body" style="display:flex;flex-direction:column;flex:1;">
    <span class="muted" style="font-size:12px;letter-spacing:.2em;">{abbr}</span>
    <span class="disp" style="display:block;font-size:22px;font-weight:500;margin-top:10px;line-height:1.2;">{name}</span>
    <span class="body" style="display:block;font-size:15px;margin-top:14px;flex:1;">{body}</span>
    <span style="display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--sr-pink);margin-top:22px;">{when}</span>
  </span>
</a>

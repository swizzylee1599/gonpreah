---
import { ViewTransitions } from 'astro:transitions';
import '../styles/sr-fonts.css';
import '../styles/sr.css';
import Nav from '../components/sr/Nav.astro';

interface Props {
  title: string;
  description?: string;
  spacer?: boolean;
  noindex?: boolean;
  /** Share-preview image (absolute path); default is the campus aerial. */
  image?: string;
  /** A page's accent colour (labels, highlights, buttons), e.g. DTS blue. */
  accent?: string;
}
const {
  title,
  description = 'YWAM Siem Reap empowers the next generation to transform their nation and the world. A Youth With A Mission training base in Siem Reap, Cambodia.',
  spacer = true,
  noindex = false,
  image = '/images/campus/campus-aerial-wide.webp',
  accent,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://ywamsiemreap.org').href;
const imageUrl = new URL(image, Astro.site ?? 'https://ywamsiemreap.org').href;
---

<!doctype html>
<html lang="en" class:list={['sr', { 'sr--accent': accent }]} style={accent ? `--sr-pink:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YWAM Siem Reap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Fonts are served from this site (src/styles/sr-fonts.css). The three
         every page needs first are preloaded so they usually arrive before
         the first paint. -->
    <link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/koulen-khmer.woff2" as="font" type="font/woff2" crossorigin />
    <ViewTransitions />
    <script is:inline>
      // Khmer / English switch (the EN · ខ្មែរ buttons in the nav). Khmer is
      // Google's automatic translation: choosing it sets Google's own
      // `googtrans` cookie and reloads; Google's script then translates each
      // page as it opens. English clears the cookie, so English visitors
      // never load Google's script.
      (function () {
        var KM = /(?:^|;\s*)googtrans=\/en\/km(?:;|$)/;
        var setLang = function (km) {
          var host = location.hostname, base = host.replace(/^www\./, '');
          if (km) document.cookie = 'googtrans=/en/km; path=/; max-age=31536000; SameSite=Lax';
          else ['', '; domain=' + host, '; domain=.' + base].forEach(function (d) {
            document.cookie = 'googtrans=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT' + d;
          });
          location.reload();
        };
        document.addEventListener('click', function (e) {
          var b = e.target instanceof Element && e.target.closest('[data-lang]');
          if (!b) return;
          var km = b.getAttribute('data-lang') === 'km';
          if (km !== KM.test(document.cookie)) setLang(km);
        });
        var mark = function () {
          var km = KM.test(document.cookie);
          document.querySelectorAll('.langsw [data-lang]').forEach(function (b) {
            b.setAttribute('aria-pressed', String((b.getAttribute('data-lang') === 'km') === km));
          });
        };
        document.addEventListener('DOMContentLoaded', mark);
        document.addEventListener('astro:page-load', mark);
        if (!KM.test(document.cookie)) return;
        document.documentElement.classList.add('sr-km');
        // While in Khmer every link is a full page load (no in-page swap), so
        // Google translates each new page from the start.
        window.addEventListener('click', function (e) {
          var a = e.target instanceof Element && e.target.closest('a[href]');
          if (a) a.setAttribute('data-astro-reload', '');
        }, true);
        document.addEventListener('astro:after-swap', function () { location.reload(); });
        window.srGT = function () {
          new google.translate.TranslateElement({ pageLanguage: 'en', includedLanguages: 'km', autoDisplay: false }, 'sr-gt');
        };
        var load = function () {
          // Words already in Khmer stay as they are.
          document.querySelectorAll('.km, [lang="km"]').forEach(function (el) { el.classList.add('notranslate'); });
          var d = document.createElement('div');
          d.id = 'sr-gt';
          document.body.appendChild(d);
          var s = document.createElement('script');
          s.src = 'https://translate.google.com/translate_a/element.js?cb=srGT';
          s.async = true;
          document.head.appendChild(s);
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load); else load();
      })();
      // Phones: background photos marked data-small use their 800px copy.
      (function () {
        var swap = function () {
          if (!window.matchMedia('(max-width: 760px)').matches) return;
          document.querySelectorAll('[data-small]').forEach(function (el) { el.style.backgroundImage = 'url(' + el.getAttribute('data-small') + ')'; });
        };
        swap(); document.addEventListener('astro:page-load', swap);
      })();
      // Lists marked data-shuffle (the Khmer staff profiles) come in a new
      // order on every visit. The component shuffles its own list as it is
      // parsed; this covers pages reached by an in-site link, where the new
      // page is swapped in (and shuffled before it is shown).
      (function () {
        var shuffle = function () {
          document.querySelectorAll('[data-shuffle]:not([data-shuffled])').forEach(function (g) {
            g.dataset.shuffled = '1';
            var c = Array.prototype.slice.call(g.children);
            for (var i = c.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = c[i]; c[i] = c[j]; c[j] = t; }
            c.forEach(function (n) { g.appendChild(n); });
          });
        };
        document.addEventListener('astro:after-swap', shuffle);
      })();
    </script>
  </head>
  <body class="sr">
    <div class="srbar"></div>
    <button class="scroll-cue" type="button" aria-label="Scroll down" tabindex="-1"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div style="min-height:100vh;background:var(--sr-ink);">
      <Nav />
      {spacer && <div style="height:109px;"></div>}
      <slot />
    </div>
    <script>
      // Scroll reveals: with a mouse or trackpad the site uses CSS
      // scroll-driven animations where the browser supports them. Touch
      // screens and older browsers get play-once reveals instead: this marks
      // elements as they enter the viewport and CSS transitions take over.
      // (Scrubbed reveals trailed the finger on phones and replayed in
      // reverse on the way back up.)
      const supportsTimeline = CSS.supports('animation-timeline: view()') && matchMedia('(hover: hover) and (pointer: fine)').matches;
      let io = null;
      const init = () => {
        if (io) io.disconnect();
        document.documentElement.classList.toggle('sr-io', !supportsTimeline);
        if (supportsTimeline) return;
        const els = document.querySelectorAll('.reveal, .stag, .linein, .wipe, .riseup, .scaleup, .growrule, .io-in, .culture-item, .road-line');
        io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
        // threshold 0: reveal as soon as any of it crosses the line. A share
        // of the element (it was 8%) can never be reached by a group taller
        // than about twelve screens' worth, e.g. a long grid of cards on a
        // phone, which then stayed invisible.
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0 });
        els.forEach((el) => io.observe(el));
      };
      init();
      document.addEventListener('astro:page-load', init);

      // Cream sections marked .paper-screen arrive out of the page black: the
      // section's own background moves from black to cream as it rises into
      // view (fully cream once its top is near the top of the screen), so it
      // reads as its own section turning the screen cream. The sections
      // around it are untouched. Scroll-linked, colour only.
      let paperOff = null;
      const initPaper = () => {
        if (paperOff) paperOff();
        paperOff = null;
        document.documentElement.classList.remove('is-paper-focus');
        const secs = [...document.querySelectorAll('.paper-screen')];
        if (!secs.length) return;
        // A black layer behind the section's content fades out, rather than
        // the section's colour changing: a fade is done by the graphics chip,
        // while a colour change repaints the whole section on every frame,
        // which lagged on phones.
        const veils = secs.map((el) => {
          let v = el.querySelector(':scope > .paper-veil');
          if (!v) { v = document.createElement('div'); v.className = 'paper-veil'; v.setAttribute('aria-hidden', 'true'); el.prepend(v); }
          return v;
        });
        const c01 = (v) => Math.min(1, Math.max(0, v));
        let raf = 0;
        const update = () => {
          raf = 0;
          const vh = innerHeight;
          let navOver = false;
          secs.forEach((el, k) => {
            const r = el.getBoundingClientRect();
            let t = c01((vh - r.top) / (vh * 0.85));
            t = t * t * (3 - 2 * t);
            veils[k].style.opacity = (1 - t).toFixed(3);
            if (t > 0.6 && r.top < 70 && r.bottom > 70) navOver = true;
          });
          document.documentElement.classList.toggle('is-paper-focus', navOver);
        };
        const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        paperOff = () => { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); cancelAnimationFrame(raf); };
        update();
      };
      initPaper();
      document.addEventListener('astro:page-load', initPaper);

      // The scroll cue: a small arrow in the corner that appears only when
      // you have stopped for a moment where it may not be obvious the page
      // goes on (the top of a page, or inside a pinned scroll scene), and
      // there is more below. It hides the moment you scroll; tapping it
      // scrolls down a screen.
      (function () {
        const cue = document.querySelector('.scroll-cue');
        if (!cue) return;
        const SCENES = '.gonpreah-stack, .journey-stack, .hall-stack, .dive-stack, .aw-stack, .dbs-stack, .sr-cards';
        let timer = 0;
        const hide = () => cue.classList.remove('is-on');
        const worth = () => {
          const vh = innerHeight;
          const left = document.documentElement.scrollHeight - (scrollY + vh);
          if (left < vh * 0.6) return false;
          if (document.querySelector('.sr-nav.is-mobile-open, .srsearch:not([hidden])')) return false;
          if (scrollY < vh * 0.3) return true;
          const mid = vh / 2;
          return [...document.querySelectorAll(SCENES)].some((el) => {
            const r = el.getBoundingClientRect();
            return r.top < mid && r.bottom > vh * 1.2;
          });
        };
        const arm = (ms) => {
          clearTimeout(timer);
          timer = setTimeout(() => { if (worth()) cue.classList.add('is-on'); }, ms);
        };
        addEventListener('scroll', () => { hide(); arm(1800); }, { passive: true });
        cue.addEventListener('click', () => { hide(); scrollBy({ top: innerHeight * 0.85, behavior: 'smooth' }); });
        document.addEventListener('astro:page-load', () => { hide(); arm(1600); });
        arm(1600);
      })();
    </script>
  </body>
</html>

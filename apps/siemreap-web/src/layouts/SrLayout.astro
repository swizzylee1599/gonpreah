---
import { ViewTransitions } from 'astro:transitions';
import '../styles/sr.css';
import Nav from '../components/sr/Nav.astro';

interface Props {
  title: string;
  description?: string;
  spacer?: boolean;
  noindex?: boolean;
  /** Share-preview image (absolute path); default is the campus aerial. */
  image?: string;
}
const {
  title,
  description = 'YWAM Siem Reap empowers the next generation to transform their nation and the world. A Youth With A Mission training base in Siem Reap, Cambodia.',
  spacer = true,
  noindex = false,
  image = '/images/campus/campus-aerial-wide.webp',
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://ywamsiemreap.org').href;
const imageUrl = new URL(image, Astro.site ?? 'https://ywamsiemreap.org').href;
---

<!doctype html>
<html lang="en" class="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YWAM Siem Reap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Koulen&family=Nunito+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />
    <script is:inline>
      // Phones: background photos marked data-small use their 800px copy.
      (function () {
        var swap = function () {
          if (!window.matchMedia('(max-width: 760px)').matches) return;
          document.querySelectorAll('[data-small]').forEach(function (el) { el.style.backgroundImage = 'url(' + el.getAttribute('data-small') + ')'; });
        };
        swap(); document.addEventListener('astro:page-load', swap);
      })();
    </script>
  </head>
  <body class="sr">
    <div class="srbar"></div>
    <div style="min-height:100vh;background:var(--sr-ink);">
      <Nav />
      {spacer && <div style="height:109px;"></div>}
      <slot />
    </div>
    <script>
      // Scroll reveals: the site uses CSS scroll-driven animations where the
      // browser supports them. Elsewhere (iOS Safari, Firefox) this marks
      // elements as they enter the viewport and CSS transitions take over.
      const supportsTimeline = CSS.supports('animation-timeline: view()');
      let io = null;
      const init = () => {
        if (io) io.disconnect();
        document.documentElement.classList.toggle('sr-io', !supportsTimeline);
        if (supportsTimeline) return;
        const els = document.querySelectorAll('.reveal, .stag, .linein, .wipe, .riseup, .scaleup, .growrule, .io-in, .culture-item');
        io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      };
      init();
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>

---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import { CONTACT } from '../lib/sr-contact';

const details: [string, string, string?][] = [
  ['WhatsApp / phone', CONTACT.phoneDisplay, CONTACT.whatsapp],
  ['Email', CONTACT.email, `mailto:${CONTACT.email}`],
  ['Base address', 'Siem Reap, Cambodia'],
  ['Social', 'Pending'],
];
---
<SrLayout title="Contact | YWAM Siem Reap"
  description="Get hold of YWAM Siem Reap on WhatsApp or by email. Someone on staff reads every message.">
  <PageHead eyebrow="Contact" km="ទំនាក់ទំនង" title="Talk to the base" highlight="the base"
    lead="WhatsApp is the quickest way to reach us. Email works too. Someone on staff reads every message." />
  <section class="sec">
    <div class="wrap">
      <div class="contact-channels">
        <a class="card contact-channel contact-channel--wa reveal" href={CONTACT.whatsapp} target="_blank" rel="noopener">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.48.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 7 2.9 9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.9 9.88m8.42-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.33 11.89-11.89a11.8 11.8 0 0 0-3.48-8.41"/></svg>
          </span>
          <p class="eyebrow" style="color:var(--gp-grey);">WhatsApp</p>
          <p class="disp contact-value">{CONTACT.phoneDisplay}</p>
          <p class="body" style="margin:10px 0 0;font-size:15px;">Message us any time. We reply during Cambodia hours.</p>
          <span class="btn btn--solid contact-btn">Open WhatsApp ↗</span>
        </a>
        <a class="card contact-channel reveal" href={`mailto:${CONTACT.email}`}>
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
          </span>
          <p class="eyebrow" style="color:var(--gp-grey);">Email</p>
          <p class="disp contact-value">{CONTACT.email}</p>
          <p class="body" style="margin:10px 0 0;font-size:15px;">For applications, teams, giving and anything longer.</p>
          <span class="btn contact-btn">Write to us</span>
        </a>
      </div>

      <div class="contact-details">
        {details.map(([k, v, href]) => (
          <div class="contact-detail">
            <p class="eyebrow" style="color:var(--gp-grey);">{k}</p>
            {href
              ? <a href={href} style="display:inline-block;margin:8px 0 0;font-size:17px;color:#fff;">{v}</a>
              : <p style="margin:8px 0 0;font-size:17px;">{v}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</SrLayout>

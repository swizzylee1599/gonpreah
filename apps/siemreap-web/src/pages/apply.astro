---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';

// Each school's application is a Google Form. Paste the form's share link into
// `form` and it appears embedded below the chooser; while null, applicants are
// pointed to the school's email instead.
const SCHOOLS: { id: string; name: string; abbr: string; when: string; form: string | null; page?: string; email: string }[] = [
  { id: 'dts', name: 'Discipleship Training School', abbr: 'DTS', when: 'Every January', form: null, page: '/schools/dts', email: 'dts@ywamsiemreap.org' },
  { id: 'dbs', name: 'Discipleship Bible School', abbr: 'DBS', when: 'Annual', form: null, email: 'info@ywamsiemreap.org' },
  { id: 'bcs', name: 'Bible Counseling School', abbr: 'BCS', when: 'New', form: null, email: 'info@ywamsiemreap.org' },
  { id: 'sms', name: 'Social Media School', abbr: 'SMS', when: 'New', form: null, email: 'info@ywamsiemreap.org' },
];

const STEPS: [string, string][] = [
  ['School application', 'Choose your school above and fill out its application form. It asks about your story, your faith, your health and your church background — the same for every school, with a few questions particular to each.'],
  ['References', 'Once your form is in, our staff get in touch to collect two references — from a church leader, a pastor or a mentor who knows you well.'],
  ['Video interview', 'A video call with our school staff. It is a two-way conversation: we want to know you, and you should be asking us questions too.'],
  ['Acceptance', 'We let you know the outcome, and if you are accepted we welcome you into the school.'],
  ['The practical part', 'Fees and how to pay them, the packing list, the visa process for Cambodia, and travel to Siem Reap — we walk you through each one.'],
  ['Arrive', 'We collect you from Siem Reap airport and get you settled on the base.'],
];
---
<SrLayout title="Apply | YWAM Siem Reap"
  description="Apply for a school at YWAM Siem Reap. Choose your school, fill out its application form, and our staff walk with you through references, an interview, acceptance and the practical steps.">
  <PageHead eyebrow="How to apply" km="ដាក់ពាក្យ" title="It all starts with the school application." highlight="school application."
    lead="Choose the school you want to apply for, fill out its application, and our staff will walk with you the rest of the way." />

  <section class="sec" style="padding-bottom:0;">
    <div class="wrap">
      <div class="card apply-chooser">
        <label class="eyebrow" for="school-select">Which school are you applying for?</label>
        <div class="select-wrap">
          <select id="school-select" class="school-select">
            <option value="">Choose a school…</option>
            {SCHOOLS.map((s) => <option value={s.id}>{s.name} ({s.abbr})</option>)}
          </select>
        </div>

        {SCHOOLS.map((s) => (
          <div class="apply-panel" data-school={s.id} hidden>
            <div class="apply-panel-head">
              <div>
                <p class="disp" style="margin:0;font-size:13px;color:var(--sr-pink);letter-spacing:.14em;text-transform:uppercase;">{s.abbr} · {s.when}</p>
                <h2 class="disp" style="margin:10px 0 0;font-size:clamp(24px,2.8vw,36px);font-weight:500;line-height:1.12;">{s.name}</h2>
              </div>
              {s.page && <a class="btn" href={s.page}>About the school</a>}
            </div>
            {s.form ? (
              <>
                <p class="body" style="margin:18px 0 0;max-width:60ch;">Fill out the form below, or open it in a new tab if you would rather.</p>
                <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:18px;">
                  <a class="btn btn--solid" href={s.form} target="_blank" rel="noopener">Open the {s.abbr} application form ↗</a>
                </div>
                <iframe class="apply-form" src={`${s.form}${s.form.includes('?') ? '&' : '?'}embedded=true`} title={`${s.name} application form`} loading="lazy"></iframe>
              </>
            ) : (
              <>
                <p class="body" style="margin:18px 0 0;max-width:60ch;">The {s.abbr} application form is being finalised. Email us and we will send it to you as soon as it is ready — and answer any questions in the meantime.</p>
                <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:22px;">
                  <a class="btn btn--solid" href={`mailto:${s.email}?subject=${encodeURIComponent(`${s.abbr} application`)}`}>Email {s.email}</a>
                  <a class="btn" href="/contact">Contact the base</a>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow">What happens next</p>
      <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.12;">Six steps, no surprises.</h2>
      <p class="body" style="margin:18px 0 0;max-width:58ch;">The process is the same for every school. Most people are through it in a few weeks.</p>
      <div class="apply-steps" style="margin-top:40px;">
        {STEPS.map(([t, d], n) => (
          <div class="apply-step reveal">
            <span class="disp" style="font-size:32px;color:var(--sr-pink);font-weight:500;">{'0' + (n + 1)}</span>
            <div>
              <h3 class="disp" style="margin:0;font-size:22px;font-weight:500;">{t}</h3>
              <p class="body" style="margin:12px 0 0;max-width:56ch;font-size:16px;">{d}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="muted" style="font-size:14px;margin-top:30px;max-width:60ch;">Applying to join staff or to volunteer? That will run through the YWAM GP Portal soon. Until then, <a href="/staff" style="color:#fff;">read about joining staff</a> or <a href="/contact" style="color:#fff;">contact the base</a>.</p>
    </div>
  </section>

  <Cta
    title="Not sure which school fits?"
    body="Tell us where you are and what you are drawn to. We will point you at the right one."
    primary={['contact', 'Ask a question']}
    secondary={['schools', 'See schools']}
  />
  <Footer />
</SrLayout>

<script>
  // The chooser shows one school's panel at a time and keeps ?school= in the
  // URL so school pages can deep-link straight to their form.
  let ctrl = null;
  const init = () => {
    if (ctrl) ctrl.abort();
    ctrl = new AbortController();
    const select = document.getElementById('school-select');
    if (!(select instanceof HTMLSelectElement)) return;
    const panels = [...document.querySelectorAll('.apply-panel')];
    const show = (id, push) => {
      panels.forEach((p) => { p.hidden = p.dataset.school !== id; });
      if (push) {
        const url = new URL(location.href);
        if (id) url.searchParams.set('school', id); else url.searchParams.delete('school');
        history.replaceState(null, '', url);
      }
    };
    const fromUrl = new URL(location.href).searchParams.get('school') || '';
    if (panels.some((p) => p.dataset.school === fromUrl)) select.value = fromUrl;
    show(select.value, false);
    select.addEventListener('change', () => show(select.value, true), { signal: ctrl.signal });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import Marquee from '../components/sr/Marquee.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';
import HeroLine from '../components/sr/HeroLine.astro';
import HeroVideo from '../components/sr/HeroVideo.astro';
import SchoolCard from '../components/sr/SchoolCard.astro';

// Add more paths here as photos are uploaded — once there's more than one,
// they automatically cycle with a flip-clock transition as you scroll past.
const GONPREAH_PHOTOS: string[] = [
  '/images/gonpreah-community.jpg',
  '/images/gonpreah-worship-1.jpg',
  '/images/gonpreah-worship-2.jpg',
];

const SCHOOL_ROWS: [string, string, string, string][] = [
  ['Discipleship Training School', 'DTS', 'The doorway into everything else. Lecture phase, then outreach phase.', 'Two intakes a year'],
  ['Discipleship Bible School', 'DBS', "An extended season in the Word, for those who want depth before they're sent.", 'Annual'],
  ['Bible Counseling School', 'BCS', 'Training for those caring for people who carry trauma — a growing need across Cambodia.', 'New'],
  ['Social Media School', 'SMS', 'Storytelling and digital ministry, for the generation already living there.', 'New'],
];
---
<SrLayout title="YWAM Siem Reap | Heart for Cambodia, vision for the world" spacer={false}>
  <div>
    <section style="position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;">
      <div class="heroimg" style="position:absolute;inset:0;">
        <PhotoSlot label="" radius={0} />
        <HeroVideo />
      </div>
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(to top, rgba(11,11,11,.96) 4%, rgba(11,11,11,.45) 55%, rgba(11,11,11,.7));"></div>
      <div class="wrap herofade sr-hero-copy" style="position:relative;pointer-events:none;padding:clamp(28px,5vh,56px) clamp(20px,5vw,40px) clamp(36px,8vh,86px);">
        <p class="eyebrow">Youth With A Mission · Cambodia</p>
        <HeroLine />
        <p class="body" style="margin:26px 0 0;max-width:50ch;">
          Empowering the next generation to transform their nation and the world
        </p>
        <div style="display:flex;gap:14px;margin-top:34px;flex-wrap:wrap;pointer-events:auto;">
          <a class="btn btn--solid" href="/schools">Explore Schools</a>
          <a class="btn" href="/visit">Bring a team</a>
        </div>
      </div>
    </section>

    <div style="position:relative;z-index:1;">
      <Marquee />

      <section class="sec">
        <div class="wrap" style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:56px;align-items:center;">
          <div class="reveal">
            <div style="display:flex;align-items:center;gap:16px;">
              <img
                src="/images/gonpreah-seal.png"
                alt=""
                aria-hidden="true"
                class="riseup"
                style="width:clamp(34px,4vw,48px);opacity:.7;pointer-events:none;flex:none;"
              />
              <p class="km" style="margin:0;font-size:clamp(30px,4vw,52px);line-height:1.5;">កូនព្រះ</p>
            </div>
            <p class="muted" style="margin:10px 0 0;font-size:16px;">GonPreah — Khmer for "child of God"</p>
            <h2 class="disp" style="margin:44px 0 0;font-size:clamp(30px,4.2vw,56px);font-weight:500;max-width:24ch;line-height:1.15;">
              Identity comes first. Purpose flows out of it.
            </h2>
            <p class="body" style="margin:28px 0 0;max-width:58ch;">
              We are not defined by what we do. We do what we do because of who we already are. Every school, every team, and every person sent from this campus starts there.
            </p>
            <a class="btn btn--plain" href="https://gonpreah.org" style="display:inline-flex;margin-top:30px;">Learn more about GonPreah ↗</a>
          </div>
          <div class="wipe" style="height:420px;overflow:hidden;border-radius:20px;">
            {GONPREAH_PHOTOS.length > 1 ? (
              <div class="photoflip" style="position:relative;width:100%;height:100%;perspective:1400px;">
                {GONPREAH_PHOTOS.map((src, i) => (
                  <img src={src} alt="The GonPreah community" class="flip-slide" />
                ))}
              </div>
            ) : (
              <div class="parslow" style="height:112%;margin-top:-6%;">
                <img
                  src={GONPREAH_PHOTOS[0]}
                  alt="The GonPreah community worshiping together outdoors"
                  style="width:100%;height:100%;object-fit:cover;display:block;"
                />
              </div>
            )}
          </div>
        </div>
      </section>

      <script>
        const photoflip = document.querySelector('.photoflip');
        if (photoflip) {
          const slides = [...photoflip.querySelectorAll('.flip-slide')];
          if (slides.length > 1) {
            const onScroll = () => {
              const rect = photoflip.getBoundingClientRect();
              const vh = window.innerHeight;
              const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
              const idx = Math.min(slides.length - 1, Math.floor(progress * slides.length));
              slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));
            };
            onScroll();
            window.addEventListener('scroll', onScroll, { passive: true });
          } else if (slides[0]) {
            slides[0].classList.add('is-active');
          }
        }
      </script>

      <div class="flipwrap">
        <section class="sec flipin" style="padding-top:84px;background:linear-gradient(#131313, var(--sr-ink) 42%);border-top:1px solid #2a2a2a;border-radius:30px 30px 0 0;box-shadow:0 -34px 70px rgba(0,0,0,.65);">
          <div class="wrap">
            <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:50px;align-items:end;">
              <h2 class="disp" style="margin:0;font-size:clamp(30px,4.2vw,56px);font-weight:500;">Train here</h2>
              <p class="body" style="margin:0;max-width:46ch;">
                Four schools, run in Khmer and English. Every one begins with who you are and ends with where you're sent.
              </p>
            </div>
          </div>
          <div class="hscroll" style="margin-top:48px;">
            {SCHOOL_ROWS.map(([name, abbr, body, when]) => (
              <SchoolCard name={name} abbr={abbr} body={body} when={when} />
            ))}
          </div>
          <div class="wrap">
            <p class="muted" style="margin:0;font-size:13px;letter-spacing:.14em;text-transform:uppercase;">Scroll for more →</p>
          </div>
        </section>
      </div>

      <section class="sec" style="padding-top:0;">
        <div class="wrap" style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:50px;align-items:center;">
          <div class="wipe" style="height:420px;overflow:hidden;border-radius:20px;">
            <div class="parslow" style="height:112%;margin-top:-6%;">
              <PhotoSlot label="Drop a photo — a visiting team working with the community" />
            </div>
          </div>
          <div class="reveal">
            <h2 class="disp" style="margin:0;font-size:clamp(30px,4.2vw,56px);font-weight:500;">Bring a team</h2>
            <p class="body" style="margin:26px 0 0;max-width:48ch;">
              We host international teams year round. You'll work alongside the Cambodian community rather than around it — on their invitation, on their terms, in their language.
            </p>
            <a class="btn btn--solid" style="margin-top:32px;display:inline-flex;" href="/visit">Plan your team's visit</a>
          </div>
        </div>
      </section>

      <section class="sec" style="padding-top:0;">
        <div class="wrap reveal">
          <h2 class="disp" style="margin:0;font-size:clamp(30px,4.2vw,56px);font-weight:500;max-width:22ch;">One table, two languages</h2>
          <div class="grid2 stag" style="margin-top:50px;gap:30px;">
            {[
              ['Khmer community', 'Local staff, students, and families who live here year round. This is a Cambodian campus first — the international community joins what Cambodians are already leading.'],
              ['International community', 'Staff and students from across the world with a heart and calling to Cambodia. Trained here, then sent to pioneer — in Cambodia and to the nations.'],
            ].map(([t, d]) => (
              <div style="border-top:1px solid #fff;padding-top:26px;">
                <h3 class="disp" style="margin:0;font-size:23px;font-weight:500;">{t}</h3>
                <p class="body" style="margin:18px 0 0;max-width:44ch;">{d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="sec" style="padding-top:0;">
        <div class="wrap reveal" style="text-align:center;border-top:1px solid #232323;padding-top:80px;">
          <h2 class="disp scaleup" style="margin:0;font-size:clamp(32px,5.4vw,72px);font-weight:500;">Discipled here. Sent everywhere.</h2>
          <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:40px;">
            <a class="btn btn--solid" href="/apply">Apply to a school</a>
            <a class="btn" href="/visit">Bring a team</a>
            <a class="btn" href="/give">Give</a>
          </div>
        </div>
      </section>
    </div>
    <Footer />
  </div>
</SrLayout>

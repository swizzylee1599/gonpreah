---
import SrLayout from '../../layouts/SrLayout.astro';
import Footer from '../../components/sr/Footer.astro';
import PageHead from '../../components/sr/PageHead.astro';
import CardGrid from '../../components/sr/CardGrid.astro';
import Cta from '../../components/sr/Cta.astro';

const FACTS: [string, string][] = [
  ['Length', '6 months'],
  ['Shape', '3 months lecture · 3 months outreach'],
  ['Language', 'English — a Khmer DTS runs alongside'],
  ['Intakes', 'Two a year'],
  ['Where', 'Siem Reap, Cambodia'],
];

const TOPICS: [string, string][] = [
  ['The Father heart of God', 'Who God actually is, and what it means to be his child before you are anything else.'],
  ['Identity and belonging', 'Unlearning the names you were given, and learning the one you already have.'],
  ['Hearing God\'s voice', 'Learning to recognise how God speaks — and building a life that has room to listen.'],
  ['Worship and intercession', 'Prayer as a way of seeing the world, not just a way of asking for things.'],
  ['The Great Commission', 'What it means that the gospel is for every nation, including the one you are standing in.'],
  ['Living it out', 'Character, relationships, forgiveness, and the quiet disciplines that hold a life together.'],
];
---
<SrLayout title="Discipleship Training School | YWAM Siem Reap" spacer={false}
  description="A six-month Discipleship Training School in Siem Reap, Cambodia: three months of lecture, three months of outreach. Find your identity in Christ and your purpose in the world.">
  <PageHead eyebrow="Discipleship Training School · DTS" km="អត្តសញ្ញាណ" title="Discover your identity. Know your purpose." highlight="Know your purpose."
    lead="Discover your identity in Christ and know your purpose in the world. DTS is a six-month school focused on knowing God and making him known — three months of lecture in Siem Reap, then three months of outreach."
    photo="/images/schools/dts.jpg" photoName="school-photo-dts"
    photoAlt="DTS students studying together around a table under a tree on the Siem Reap campus" />

  <section class="sec">
    <div class="wrap" style="display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:50px;align-items:start;">
      <div>
        <p class="eyebrow">Why identity comes first</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.12;">You are not what you do.</h2>
      </div>
      <div>
        <p class="body" style="margin:0;max-width:58ch;">Most of us arrive carrying a name we were handed — by family, by failure, by what we have managed to achieve. DTS starts by putting that down. Before anyone talks about calling or nations or ministry, we spend real time on the one thing that holds everything else up: you are a child of God, and that is not something you earn.</p>
        <p class="body" style="margin:16px 0 0;max-width:58ch;">Purpose grows out of that. Not the other way around.</p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;">
    <div class="wrap grid2 reveal">
      <div class="card">
        <p class="disp" style="margin:0;font-size:13px;color:var(--sr-pink);">Months 1–3</p>
        <h3 class="disp" style="margin:18px 0 0;font-size:26px;font-weight:500;">Lecture phase</h3>
        <span class="rule" style="margin:18px 0;"></span>
        <p class="body" style="margin:0;font-size:16px;">Twelve weeks on campus in Siem Reap. A different speaker and theme each week, small groups that go deep, time in the Word, and a community that eats, worships and lives together. This is where identity gets worked out — not as an idea, but in the room, with people.</p>
      </div>
      <div class="card">
        <p class="disp" style="margin:0;font-size:13px;color:var(--sr-pink);">Months 4–6</p>
        <h3 class="disp" style="margin:18px 0 0;font-size:26px;font-weight:500;">Outreach phase</h3>
        <span class="rule" style="margin:18px 0;"></span>
        <p class="body" style="margin:0;font-size:16px;">Then you go. Your team serves in villages around Siem Reap or in another part of Cambodia and Southeast Asia — alongside local churches and leaders, on their invitation. Purpose stops being a question you ask and becomes something you do, one ordinary day at a time.</p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;">
    <div class="wrap">
      <p class="eyebrow">What you'll walk through</p>
      <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;">Six months, one thread.</h2>
    </div>
  </section>
  <div style="margin-top:-40px;">
    <CardGrid items={TOPICS} />
  </div>

  <section class="sec" style="padding-top:0;">
    <div class="wrap card reveal" style="padding:40px 48px;">
      <dl style="margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:28px 34px;">
        {FACTS.map(([k, v]) => (
          <div>
            <dt class="eyebrow" style="margin:0;">{k}</dt>
            <dd class="disp" style="margin:12px 0 0;font-size:20px;font-weight:500;line-height:1.3;">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Cta
    title="Ready to start with who you are?"
    body="Two intakes a year. Tell us a little about yourself and we will walk you through dates, cost and what to expect."
    primary={['apply', 'Apply for DTS']}
    secondary={['contact', 'Ask a question']}
  />
  <Footer />
</SrLayout>

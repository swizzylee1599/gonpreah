---
import { applyUrl } from '../../lib/sr-routes';
import { srcset } from '../../lib/sr-img';
import SchoolInfo from '../../components/sr/SchoolInfo.astro';
import SrLayout from '../../layouts/SrLayout.astro';
import Footer from '../../components/sr/Footer.astro';
import PageHead from '../../components/sr/PageHead.astro';
import PhotoSlot from '../../components/sr/PhotoSlot.astro';
import Cta from '../../components/sr/Cta.astro';
import CampusTeaser from '../../components/sr/CampusTeaser.astro';

const JOURNEY: { title: string; body: string; photo: string; alt: string }[] = [
  {
    title: 'Apply for DTS',
    body: 'Join our community surrounded by leaders and friends who have a heart to serve God and the nations. We will help you find your identity in Christ and your purpose in the world.',
    photo: '/images/gonpreah-community.webp',
    alt: 'The community worshipping with hands raised in front of the band, one student in a GonPreah shirt',
  },
  {
    title: 'Know God',
    body: "In the six months, you will study God's word and make it known to the nations. Learn to hear God's voice and to walk out in the calling He has for you.",
    photo: '/images/schools/dts-know-god.webp',
    alt: 'A DTS lecture on hearing God\'s voice — students in class with a speaker and translator at the front',
  },
  {
    title: 'Discover your calling',
    body: 'Find your purpose in the world. God has a distinctive calling on each of our lives and has given you skills and passion for a purpose. Through DTS, you will be equipped and empowered to use the gifts God has given you to bring His love into your community.',
    photo: '/images/schools/dts-calling.webp',
    alt: 'Two DTS students walking down a village path in Cambodia, each holding a young girl\'s hand',
  },
];

// Each phase gets a four-photo collage — swap `label` slots for `{ src, alt }` as photos arrive.
type Photo = { src?: string; alt?: string; label?: string; pos?: string };
const PHASES: { eyebrow: string; title: string; body: string[]; photos: Photo[] }[] = [
  {
    eyebrow: 'Lecture phase · 3 months here',
    title: 'Training phase',
    body: [
      "Leaders from around the world teaching to help you hear God's voice and find the calling He has for you.",
      'Twelve weeks of lecture, twelve topics — from speakers locally and internationally.',
    ],
    photos: [
      { src: '/images/schools/dts-lecture.webp', alt: 'A speaker teaching at a map of the world while students listen' },
      { src: '/images/campus/worship-leader.webp', alt: 'A worship leader singing with one hand raised' },
      { src: '/images/schools/dts-baptism.webp', alt: 'A young man celebrating in the river just after his baptism, friends beside him', pos: '50% 28%' },
      { src: '/images/schools/dts-teaching.webp', alt: 'Base director Uriah Lyford teaching a class, his name on the screen behind him', pos: '45% 40%' },
      { src: '/images/campus/worship-band-bw.webp', alt: 'The worship band mid-song, in black and white', pos: '50% 40%' },
    ],
  },
  {
    eyebrow: 'Outreach phase · 3 months to the nations',
    title: 'To the nations',
    body: [
      'Go to the nations, encounter Jesus in different cultures, and bring the love of Christ through the gospel to the unreached.',
      'Teams serve here in Cambodia — in villages around Siem Reap and across the country — and beyond its borders.',
    ],
    photos: [
      { src: '/images/schools/outreach-team.webp', alt: 'A DTS outreach team in bright traditional dresses and shirts, standing on a hillside above a town', pos: '50% 40%' },
      { src: '/images/campus/night-actions.webp', alt: 'Students leading actions together in the courtyard at night' },
      { src: '/images/schools/outreach-kids-friends.webp', alt: 'A DTS student laughing with a group of children on outreach', pos: '50% 30%' },
      { src: '/images/schools/outreach-lakeside.webp', alt: 'Four DTS students talking on a bench beside a lake on outreach', pos: '50% 55%' },
      { src: '/images/schools/outreach-kids-courtyard.webp', alt: 'DTS students sitting among dozens of children in a school courtyard on outreach', pos: '50% 60%' },
    ],
  },
];
// Higgsfield dolly shot down the corridor, scrubbed by scroll. Until the clip
// is uploaded to public/video the still photo zooms in as a stand-in.
const HALL_VIDEO: string | null = '/video/dts-hallway.mp4';



// Tracks: a skill each student chooses to develop through the school.
// Culinary and Hospitality lines are drafts to be confirmed.
const TRACKS: { name: string; km: string; tag: string; body: string; photo?: string; alt?: string; pos?: string; label: string }[] = [
  { name: 'Media', km: 'មេឌា', body: 'Social media is one of the most effective ways to reach the youth. Develop your skills in content creating, video editing and photography, and see how you can use media for the Kingdom.', tag: 'Create, film and edit for the Kingdom.', photo: '/images/schools/sms-filming.webp', alt: 'A film crew on a Siem Reap street', pos: '50% 45%', label: 'Drop a photo — media track' },
  { name: 'Music', km: 'តន្ត្រី', body: 'Worship is our weapon. Live out Psalm 96, bringing newness as we merge music with the arts. Join us as we continue to foster the heart of worship.', tag: 'Worship is our weapon.', photo: '/images/campus/worship-band.webp', alt: 'A student worship band playing on stage', label: 'Drop a photo — music track' },
  { name: 'Cafe', km: 'កាហ្វេ', body: 'Develop barista skills, learn business management, and see how you can serve Jesus in the business world.', tag: 'Barista skills and business.', photo: '/images/campus/gp-cafe-iced.webp', alt: 'Two iced coffees from GP Cafe held up together', label: 'Drop a photo — cafe track' },
  { name: 'Culinary', km: 'ម្ហូប', body: 'Develop skills in food and the kitchen — Khmer and international cooking, planning and preparing meals for a community — and see how a table can serve the Kingdom.', tag: 'Cook for a community.', photo: '/images/campus/food-prep.webp', alt: 'Preparing food at a market table', pos: '50% 60%', label: 'Drop a photo — culinary track' },
  { name: 'Hospitality', km: 'បដិសណ្ឋារកិច្ច', body: 'Learn skills in hotel management — welcoming guests, running rooms and events, hosting teams — and see how hospitality opens doors for the gospel in Siem Reap.', tag: 'Welcome guests, run a house.', photo: '/images/campus/campus-front.webp', alt: 'The rooftop terrace set for guests', pos: '50% 45%', label: 'Drop a photo — hospitality track' },
  { name: 'Technical', km: 'បច្ចេកទេស', body: 'Develop technical skills, from AC repair to building furniture, to serve Jesus in the business world.', tag: 'Fix, build and serve.', photo: '/images/campus/building-stairs.webp', alt: 'Three young men fitting a wooden staircase against a brick wall', pos: '55% 40%', label: 'Drop a photo — technical track' },
];

const FAQ: [string, string][] = [
  ['Who can apply for DTS?', 'Anyone 18 or over with a hunger to know God and make Him known. You do not need any previous Bible training or ministry experience — DTS is the starting point.'],
  ['What language is the school taught in?', 'DTS is a bilingual school. Teaching is in Khmer and English, with translation, so Cambodian and international students learn side by side.'],
  ['What do Country A, B and C mean?', 'School fees are tiered by the country on your passport so the school stays accessible to students from every nation. When you apply, we will tell you which tier applies to you.'],
  ['What does the fee cover?', 'Lecture phase fees cover your teaching, accommodation and meals on campus in Siem Reap. Outreach fees cover travel, accommodation and food during the outreach phase. Flights to and from Cambodia, visas, insurance and personal spending are not included.'],
  ['Where does outreach go?', 'Outreach teams serve in villages around Siem Reap and across Cambodia, and to other nations in Southeast Asia and beyond. Locations are confirmed during the lecture phase, and outreach costs range from $1,500 to $2,500 USD depending on where your team goes.'],
  ['When does the school start?', 'DTS runs once a year, starting in January. The next school runs from arrival day on January 3, 2027 to departure day on June 10, 2027 — or email dts@ywamsiemreap.org and we will send you the dates.'],
  ['What is a week in lecture phase like?', 'A different speaker and topic each week — twelve weeks, twelve topics, from leaders locally and internationally — alongside worship, small groups, time in the Word, and serving in the local community.'],
  ['What happens after DTS?', 'DTS is the entry point to the University of the Nations. Many students go on to further schools, join staff at a YWAM base, or take what they have learned back into their church, work and city.'],
];
---
<SrLayout title="Discipleship Training School | YWAM Siem Reap" spacer={false} accent="#0584f9"
  description="A six-month Discipleship Training School in Siem Reap, Cambodia: three months of lecture, then three months on outreach to the nations. Know God and make Him known.">
  <PageHead eyebrow="Discipleship Training School · DTS" km="អត្តសញ្ញាណ" title="Discover your identity. Know your purpose." highlight="Know your purpose." rule={false} video
    photo="/images/gonpreah-worship-2.webp" photoPos="28% 35%" mobileFull
    photoAlt="Students and staff worshipping on campus with hands raised under string lights" />

  <div class="journey-stack">
    <div class="journey-pin">
      <div class="wrap">
        <div class="jp-head">
          <p class="eyebrow">Begin your journey</p>
          <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.12;">Know God. Discover your calling.</h2>
        </div>
        <div class="jp-grid">
          <div class="jp-photos">
            {JOURNEY.map((step, i) => step.photo
              ? <img class="jp-photo" src={step.photo} srcset={srcset(step.photo)} sizes="(max-width: 760px) 100vw, 50vw" alt={step.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              : <div class="jp-photo jp-photo--slot"><PhotoSlot label={`Drop a photo — ${step.title}`} radius={0} /></div>)}
          </div>
          <div class="jp-steps">
            {JOURNEY.map((step, i) => (
              <div class="jp-step">
                <p class="disp" style="margin:0;font-size:13px;color:var(--sr-pink);">{'0' + (i + 1)}</p>
                <h3 class="disp" style="margin:14px 0 0;font-size:clamp(24px,2.6vw,34px);font-weight:500;line-height:1.15;">{step.title}</h3>
                <span class="rule" style="margin:18px 0;"></span>
                <p class="body" style="margin:0;max-width:46ch;">{step.body}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="jp-rail" aria-hidden="true">
          {JOURNEY.map((step, i) => (
            <span class="jp-rail-label"><b>{'0' + (i + 1)}</b> {step.title}</span>
          ))}
          <span class="jp-rail-bar"><i></i></span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { stableVh } from '../../lib/sr-viewport';
    // Pinned stepper: the panel stays put while scrolling through the
    // stack. The first 78% of progress flips through the photos and
    // swaps the step copy; the last 22% slides the heading off to the
    // right and fades the rest while the breakdown section rides up over it.
    const STEPS_END = 0.78;

    // The hallway: the breakdown pins and scrolling walks you down the
    // corridor. Progress 0-.1 is the intro heading; each phase then gets a
    // window in which its copy grows toward you and passes, while its
    // photos hang on the walls and slide by in perspective.
    // Phases end at .78; the information card then rises into the hall (.8-.9) and holds to the end.
    const HALL_PHASES = [[0.18, 0.5], [0.5, 0.78]];
    const CARD_START = 0.8, CARD_IN = 0.1;
    const INTRO_HOLD = 0.08, INTRO_FADE = 0.12;
    const clamp01 = (v) => Math.min(1, Math.max(0, v));
    const smooth = (t) => t * t * (3 - 2 * t);
    // The hallway walk as still frames (public/video/dts-hallway-frames,
    // 12 per second of the clip) drawn to fill a canvas like the video did
    // (object-fit: cover, 50% 59%). Frames load once the hallway is within a
    // screen of view, coarse first (every 64th, then 32nd, ...) so the walk
    // works straight away and sharpens as the rest arrive.
    const FRAME_COUNT = 121;
    const frameSrc = (i) => `/video/dts-hallway-frames/${String(i).padStart(3, '0')}.webp`;
    const hallFrames = (hall, still, signal) => {
      const bg = hall.querySelector('.hall-bg');
      let canvas = bg.querySelector('.hall-canvas');
      if (!canvas) {
        canvas = document.createElement('canvas');
        canvas.className = 'hall-canvas';
        canvas.setAttribute('aria-hidden', 'true');
        bg.appendChild(canvas);
      }
      const ctx = canvas.getContext('2d');
      const imgs = new Array(FRAME_COUNT);
      let want = 0, shown = -1, width = 0;
      const nearest = (i) => {
        for (let d = 0; d < FRAME_COUNT; d++) {
          if (imgs[i - d]) return i - d;
          if (imgs[i + d]) return i + d;
        }
        return -1;
      };
      const draw = () => {
        const k = nearest(want);
        if (k < 0 || k === shown || !canvas.width) return;
        const im = imgs[k];
        const cw = canvas.width, ch = canvas.height;
        const sc = Math.max(cw / im.naturalWidth, ch / im.naturalHeight);
        const w = im.naturalWidth * sc, h = im.naturalHeight * sc;
        ctx.drawImage(im, (cw - w) * 0.5, (ch - h) * 0.59, w, h);
        if (shown < 0 && still) still.style.opacity = '0';
        shown = k;
      };
      const size = () => {
        const r = canvas.getBoundingClientRect();
        if (!r.width || r.width === width) return;
        width = r.width;
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.round(r.width * dpr);
        canvas.height = Math.round(r.height * dpr);
        shown = -1;
        draw();
      };
      // coarse-to-fine load order
      const order = [];
      for (let step = 64; step >= 1; step /= 2) for (let i = 0; i < FRAME_COUNT; i += step) if (!order.includes(i)) order.push(i);
      if (!order.includes(FRAME_COUNT - 1)) order.splice(1, 0, FRAME_COUNT - 1);
      const load = async () => {
        let next = 0;
        const worker = async () => {
          while (next < order.length && !signal.aborted) {
            const i = order[next++];
            const im = new Image();
            im.src = frameSrc(i);
            try { await im.decode(); } catch { continue; }
            if (signal.aborted) return;
            imgs[i] = im;
            draw(); // a nearer frame may have arrived (draw does nothing if not)
          }
        };
        await Promise.all(Array.from({ length: 6 }, worker));
      };
      const near = new IntersectionObserver((en) => { if (en[0].isIntersecting) { near.disconnect(); size(); load(); } }, { rootMargin: '100% 0px' });
      near.observe(hall);
      signal.addEventListener('abort', () => near.disconnect());
      window.addEventListener('resize', size, { signal });
      return {
        show(t) {
          want = Math.max(0, Math.min(FRAME_COUNT - 1, Math.round(t * (FRAME_COUNT - 1))));
          if (!width) size();
          draw();
        },
      };
    };
    const initHall = (signal) => {
      const hall = document.querySelector('.hall-stack');
      if (!hall || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const still = hall.querySelector('.hall-still');
      // Phones get a lighter clip (dense keyframes, so exact seeks are cheap)
      // and no blur filters, which are costly there.
      const lite = matchMedia('(max-width: 760px), (pointer: coarse)').matches;
      let video = hall.querySelector('.hall-video');
      // Phones and touch screens: the walk is a set of still frames drawn on a
      // canvas instead of a video. Seeking a video on each scroll step
      // delivered frames unevenly and the hallway shook; a frame from memory
      // is instant and always the right one.
      let frames = null;
      // (The video stays in the page, unloaded and hidden, so this still works
      // when the setup runs again after a page change.)
      if (lite && video) { video.hidden = true; video = null; frames = hallFrames(hall, still, signal); }
      if (video) {
        const phone = matchMedia('(max-width: 760px)').matches;
        // Fetch the clip only once its section is within a screen of view, and
        // fetch it whole, then play it from memory: seeking a streamed clip
        // waits on the network, so the walk trailed the finger and kept
        // moving after you stopped. Falls back to streaming if the download
        // fails.
        const startClip = async () => {
          const src = (phone && video.dataset.srcMobile) || video.dataset.src;
          try {
            const res = await fetch(src);
            if (!res.ok) throw new Error(String(res.status));
            const url = URL.createObjectURL(await res.blob());
            signal.addEventListener('abort', () => URL.revokeObjectURL(url));
            if (!video || signal.aborted) return;
            video.src = url;
          } catch {
            if (!video || signal.aborted) return;
            video.src = `${src}#t=0.001`;
          }
          video.load();
        };
        const near = new IntersectionObserver((en) => { if (en[0].isIntersecting) { near.disconnect(); startClip(); } }, { rootMargin: '100% 0px' });
        near.observe(video); signal.addEventListener('abort', () => near.disconnect());
      }
      const pin = hall.querySelector('.hall-pin');
      const intro = hall.querySelector('.hall-intro');
      let card = hall.querySelector('.hall-card');
      // Phones: a tall card inside a pinned screen scrolls awkwardly, so it
      // moves out below the hallway and the walk ends where the phases end.
      let pEnd = 1;
      if (lite && card) {
        const sec = document.createElement('section');
        sec.className = 'sec hall-card-sec';
        const wrap = document.createElement('div');
        wrap.className = 'wrap';
        sec.appendChild(wrap);
        wrap.appendChild(card);
        hall.after(sec);
        hall.classList.add('is-card-out');
        card = null;
        pEnd = HALL_PHASES[HALL_PHASES.length - 1][1] + 0.02;
      }
      // Phones and touch screens: the hallway stays pinned and each part
      // fades away in place as the next fades in. Fades only, never movement
      // or scale: a fade that lands a frame late can't look like a jump.
      const fadeout = hall.querySelector('.hall-fadeout');
      const copies = [...hall.querySelectorAll('.hall-copy')];
      const rows = [...hall.querySelectorAll('.hall-photos')].map((el) => ({
        el, phase: +el.dataset.phase, items: [...el.querySelectorAll('.hall-photo')],
      }));

      let seeking = false, latest = 0, dirty = false;
      const seekTo = (t) => {
        latest = t; dirty = true;
        if (seeking || !video) return;
        seeking = true; dirty = false;
        // Exact seeks, not fastSeek: fastSeek snaps to keyframes and the walk stutters.
        video.currentTime = t;
      };
      if (video) {
        // The still stays underneath until the clip has decoded a frame, and takes over again if the clip fails.
        // The walk only ever moves with the scroll: after this one play to wake
        // the decoder, any playback (an autoplay policy, a resumed tab) is
        // paused straight away.
        let primed = false;
        const prime = () => {
          const p = video.play();
          if (p && p.then) p.then(() => { video.pause(); primed = true; }).catch(() => { primed = true; });
          else primed = true;
          if (still) still.style.opacity = '0';
        };
        video.addEventListener('play', () => { if (primed) video.pause(); }, { signal });
        if (video.readyState >= 2) prime(); else video.addEventListener('loadeddata', prime, { once: true, signal });
        // When autoplay is blocked (Low Power Mode, data saver), the first touch starts it.
        const unlock = () => { if (video && video.readyState < 2) { video.load(); prime(); } };
        for (const ev of ['touchstart', 'touchend', 'click']) window.addEventListener(ev, unlock, { passive: true, signal, once: true });
        video.addEventListener('error', () => { video.remove(); video = null; if (still) still.style.opacity = '1'; }, { once: true, signal });
        video.addEventListener('seeked', () => { seeking = false; if (dirty) seekTo(latest); }, { signal });
      }

      const measure = () => {
        const rect = hall.getBoundingClientRect();
        const scrollable = rect.height - (pin ? pin.offsetHeight : window.innerHeight);
        return scrollable <= 0 ? 0 : clamp01((-rect.top / scrollable) * pEnd);
      };
      // The walk follows the finger 1:1; easing toward the scroll position
      // made it trail behind and felt laggy on phones.
      let raf = 0;
      const frame = () => {
        raf = 0;
        render(measure());
      };
      const render = (p) => {
        if (frames) frames.show(p * 0.985);
        else if (video && video.duration && !Number.isNaN(video.duration)) seekTo(p * video.duration * 0.985);
        // Phones: the still holds (a script-driven zoom on the pinned backdrop
        // jittered); desktop pushes in on it until the clip is here.
        else if (still && !lite) still.style.transform = `translate3d(0, ${(-p * (lite ? 2 : 4)).toFixed(2)}%, 0) scale(${(1 + p * (lite ? 0.45 : 0.9)).toFixed(4)})`;
        // Phones: the walk's last stretch dims to black as the information
        // card rises over it.
        if (lite && fadeout) fadeout.style.opacity = smooth(clamp01((p / pEnd - 0.8) / 0.14)).toFixed(3);

        const io = clamp01((p - INTRO_HOLD) / INTRO_FADE);
        intro.style.opacity = String(1 - io);
        // Touch screens: fade only. Scaled text shimmers in Safari, and
        // movement trailed the finger during a flick.
        intro.style.transform = lite
          ? 'translate(-50%,-50%)'
          : `translate(-50%,-50%) scale(${(1 + io * 0.25).toFixed(3)})`;
        intro.style.filter = (!lite && io) ? `blur(${(io * 6).toFixed(1)}px)` : '';
        intro.style.pointerEvents = io > 0.5 ? 'none' : '';

        copies.forEach((el, i) => {
          const [a, b] = HALL_PHASES[i];
          const t = clamp01((p - a) / (b - a));
          // approach (0-.55): grows toward you; hold (.55-.82): full size, barely drifting; pass (.82-1): through and gone
          let scale = 0.5, op = 0, blur = 0;
          if (t > 0 && t < 1) {
            if (t < 0.55) { const u = t / 0.55; scale = 0.5 + 0.5 * smooth(u); op = clamp01(u / 0.35); }
            else if (t < 0.82) { scale = 1 + ((t - 0.55) / 0.27) * 0.04; op = 1; }
            else { const v = (t - 0.82) / 0.18; scale = 1.04 + 0.7 * v; op = 1 - smooth(v); blur = v * 8; }
          }
          el.style.opacity = String(op);
          if (lite) {
            // Fade in, hold, fade out, in place.
            el.style.transform = 'translate(-50%,-50%)';
          } else {
            el.style.transform = `translate(-50%,-50%) scale(${scale.toFixed(3)})`;
          }
          el.style.filter = (!lite && blur) ? `blur(${blur.toFixed(1)}px)` : '';
          el.style.pointerEvents = op > 0.5 ? '' : 'none';
        });

        if (card) {
          const c = clamp01((p - CARD_START) / CARD_IN);
          const e = smooth(c);
          card.style.opacity = String(e);
          card.style.transform = `translate(-50%, -50%) translateY(${((1 - e) * 60).toFixed(1)}px) scale(${(0.94 + 0.06 * e).toFixed(3)})`;
          card.style.pointerEvents = c > 0.6 ? 'auto' : 'none';
        }

        // Photos: a collage of different sizes that lands one piece at a
        // time just behind the copy, holds for most of the phase, then drifts
        // past. Each keeps its own tilt (--r) from the stylesheet.
        rows.forEach(({ el, phase, items }) => {
          const [a, b] = HALL_PHASES[phase];
          const t = clamp01((p - a) / (b - a));
          el.style.pointerEvents = t > 0.15 && t < 0.92 ? 'auto' : 'none';
          items.forEach((item, k) => {
            const tk = clamp01((t - 0.04 - k * 0.04) / 0.8);
            let scale = 0.86, op = 0, y = 40, blur = 0;
            if (tk > 0 && tk < 1) {
              if (tk < 0.34) { const e = smooth(tk / 0.34); scale = 0.86 + 0.14 * e; op = clamp01(tk / 0.16); y = 40 * (1 - e); }
              else if (tk < 0.86) { scale = 1; op = 1; y = 0; }
              else { const v = (tk - 0.86) / 0.14; scale = 1 + 0.18 * v; op = 1 - smooth(v); y = -20 * v; blur = v * 5; }
            }
            item.style.opacity = op.toFixed(3);
            // Touch screens: each photo just fades in and out at its spot.
            item.style.transform = lite
              ? 'rotate(var(--r, 0deg))'
              : `translate3d(0, ${y.toFixed(1)}px, 0) rotate(var(--r, 0deg)) scale(${scale.toFixed(3)})`;
            item.style.filter = (!lite && blur) ? `blur(${blur.toFixed(1)}px)` : '';
          });
        });
      };
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(frame); };
      frame();
      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', onScroll, { signal });
    };

    let ctrl = null;
    const init = () => {
      if (ctrl) ctrl.abort();
      ctrl = new AbortController();
      const { signal } = ctrl;

      initHall(signal);

      // Tracks on phones: a swipeable row with arrow buttons and a counter.
      // The arrows slide one card at a time and dim at either end.
      const row = document.querySelector('.tracks');
      const prevBtn = document.querySelector('[data-tracks-prev]');
      const nextBtn = document.querySelector('[data-tracks-next]');
      const countEl = document.querySelector('[data-tracks-n]');
      if (row && prevBtn && nextBtn) {
        const cards = [...row.children];
        const current = () => {
          let best = 0, bestD = Infinity;
          const left = row.getBoundingClientRect().left;
          cards.forEach((c, i) => { const d = Math.abs(c.getBoundingClientRect().left - left - 20); if (d < bestD) { bestD = d; best = i; } });
          return best;
        };
        const go = (i) => {
          const c = cards[Math.max(0, Math.min(cards.length - 1, i))];
          row.scrollTo({ left: c.offsetLeft - row.firstElementChild.offsetLeft, behavior: 'smooth' });
        };
        const sync = () => {
          const i = current();
          if (countEl) countEl.textContent = String(i + 1).padStart(2, '0');
          const atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
          prevBtn.disabled = i === 0 && row.scrollLeft < 4;
          nextBtn.disabled = atEnd;
        };
        prevBtn.addEventListener('click', () => go(current() - 1), { signal });
        nextBtn.addEventListener('click', () => go(current() + 1), { signal });
        let sraf = 0;
        row.addEventListener('scroll', () => { if (!sraf) sraf = requestAnimationFrame(() => { sraf = 0; sync(); }); }, { passive: true, signal });
        sync();
      }

      const stack = document.querySelector('.journey-stack');
      if (!stack) return;
      const head = stack.querySelector('.jp-head');
      const grid = stack.querySelector('.jp-grid');
      const rail = stack.querySelector('.jp-rail');
      const photos = [...stack.querySelectorAll('.jp-photo')];
      const steps = [...stack.querySelectorAll('.jp-step')];
      const labels = [...stack.querySelectorAll('.jp-rail-label')];
      const bar = stack.querySelector('.jp-rail-bar i');
      const n = steps.length;
      if (n < 2) return;
      const jpin = stack.querySelector('.journey-pin');
      // Phones and touch screens: photos crossfade and the heading fades
      // out instead of sliding, so nothing moved by script can trail the
      // finger during a flick.
      const fadeOnly = matchMedia('(max-width: 760px), (pointer: coarse)').matches;
      const jmeasure = () => {
        const rect = stack.getBoundingClientRect();
        const scrollable = rect.height - (jpin ? jpin.offsetHeight : window.innerHeight);
        return scrollable <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / scrollable));
      };
      let ticking = false;
      const update = () => {
        ticking = false;
        const p = jmeasure();
        const d = Math.min(1, p / STEPS_END) * (n - 1);
        const exit = Math.min(1, Math.max(0, (p - STEPS_END) / (1 - STEPS_END)));
        steps.forEach((step, i) => {
          const w = Math.max(0, 1 - Math.abs(d - i));
          const dir = d > i ? -1 : 1;
          // Copy holds while its photo is mostly facing, and hands over in a short window around the midpoint.
          // Phones fade only, so hand over in sequence (the old copy is gone
          // before the new one appears) rather than overlapping.
          const tw = fadeOnly ? Math.min(1, Math.max(0, (w - 0.5) / 0.25)) : Math.min(1, Math.max(0, (w - 0.35) / 0.3));
          step.style.opacity = String(tw);
          step.style.transform = fadeOnly ? '' : `translateY(${(1 - tw) * 26 * dir}px)`;
          step.style.pointerEvents = tw > 0.5 ? '' : 'none';
          if (photos[i]) {
            // Card deal: each photo slides in from the right over the one before it, which stays put underneath.
            const t = i === 0 ? 1 : Math.min(1, Math.max(0, d - (i - 1)));
            const e = t * t * (3 - 2 * t);
            if (fadeOnly) {
              photos[i].style.transform = 'none';
              photos[i].style.opacity = String(e);
            } else {
              photos[i].style.transform = `translate(${(1 - e) * 108}%, ${(1 - e) * 6}%) rotate(${(1 - e) * 5}deg)`;
            }
            photos[i].style.zIndex = String(i + 1);
          }
          if (labels[i]) labels[i].style.opacity = String(0.35 + 0.65 * w);
        });
        if (bar) bar.style.transform = `scaleX(${Math.min(1, p / STEPS_END)})`;
        const ease = exit * exit * (3 - 2 * exit);
        // Phones: no exit fade; the breakdown panel slides up over the stepper
        // while it stays crisp underneath (a fade here read as a dark smear).
        if (!fadeOnly) {
          if (head) head.style.transform = `translateX(${ease * 110}vw)`;
          if (grid) grid.style.opacity = String(1 - ease);
          if (rail) rail.style.opacity = String(1 - ease);
        }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      update();
      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', onScroll, { signal });
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>


---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import CardGrid from '../components/sr/CardGrid.astro';
import Cta from '../components/sr/Cta.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';
---
<SrLayout title="Join Staff or Volunteer | YWAM Siem Reap">
  <PageHead eyebrow="Join staff or volunteer" km="ក្រុមការងារ" title="Serve long term. Or come short term." highlight="short term."
    lead="Staff here are Khmer and international, some for two years, some for twenty. Volunteers come for a few weeks or a few months. All of them raise their own support, and all of them live in the community." />
  <section class="sec">
    <div class="wrap grid3 reveal">
      {[0, 1, 2, 3, 4, 5].map(() => (
        <div class="card" style="padding:0;overflow:hidden;">
          <div style="height:250px;"><PhotoSlot label="Staff portrait" radius={0} /></div>
          <div style="padding:22px 24px 26px;">
            <p class="disp" style="margin:0;font-size:17px;font-weight:500;">Name pending</p>
            <p class="muted" style="margin:6px 0 0;font-size:14px;">Role pending</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <CardGrid cols={2} items={[
    ['Joining staff', 'Staff complete a DTS first, then apply to a role on the base. We will talk you through visas, support raising and housing.'],
    ['Volunteering short term', 'A few weeks to a few months. Trades, admin, teaching, media and practical skills — often the most useful people on site. No DTS required.'],
  ]} />
  <section class="sec" style="padding-top:0;">
    <div class="wrap" style="display:flex;gap:14px;flex-wrap:wrap;">
      <a class="btn btn--solid" href="/apply?school=staff">Staff application</a>
      <a class="btn" href="/apply?school=volunteer">Volunteer application</a>
      <a class="btn btn--plain" href="/campus-life">Campus life</a>
    </div>
  </section>
  <Cta
    title="Think you might belong here?"
    body="Tell us what you do and when you are free. We would rather hear from you early than late."
    primary={['apply', 'Apply to staff or volunteer']}
    secondary={['contact', 'Get in touch']}
  />
  <Footer />
</SrLayout>

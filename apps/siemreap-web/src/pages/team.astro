---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import Cta from '../components/sr/Cta.astro';
import { TEAM, type Member } from '../lib/sr-team';
import { srcset } from '../lib/sr-img';
import { existsSync } from 'node:fs';

// Portraits: a member whose file is in public/images/team/portraits shows
// it; everyone else gets an empty slot with their name, so the layout can
// be judged before the photos arrive. Drop a photo in as <slug>.webp.
const PORTRAITS = 'public/images/team/portraits/';
const portrait = (slug: string) => (existsSync(`${PORTRAITS}${slug}.webp`) ? `/images/team/portraits/${slug}.webp` : null);
// Everyone together, no departments: couples and families serve in
// different ministries, so they stay on one wide card with each person's
// role. Leadership closes the page.
const SECTIONS: { title: string; id: string; lead?: boolean; members: Member[] }[] = [
  { title: 'Staff', id: 'staff', members: TEAM.filter((m) => !m.lead) },
  { title: 'Leadership', id: 'leadership', lead: true, members: TEAM.filter((m) => m.lead) },
];
const KIND = { couple: 'Couple', family: 'Family' } as const;
const khmer = TEAM.filter((m) => m.khmer).length;
const nations = 6;
---
<SrLayout title="Our Team | YWAM Siem Reap" noindex spacer={false}
  description="The Khmer and international staff of YWAM Siem Reap: campus leaders, DTS and DBS staff, media, music, hospitality, technical and teams.">
  <header class="tm-hero">
    <img class="tm-hero-bg" src="/images/campus/campus-group.webp" srcset={srcset('/images/campus/campus-group.webp')} sizes="100vw" alt="The YWAM Siem Reap community gathered in the campus courtyard" loading="eager" decoding="async" fetchpriority="high" />
    <div class="tm-hero-scrim" aria-hidden="true"></div>
    <div class="wrap tm-hero-copy">
      <p class="eyebrow">Our team</p>
      <h1 class="disp tm-title">Meet<br />the team.</h1>
      <p class="km tm-km">ក្រុមការងារ</p>
    </div>
  </header>

  <section class="sec tm-intro">
    <div class="wrap tm-intro-grid">
      <div class="tm-stats stag">
        <div class="tm-stat"><span class="disp tm-stat-n">{TEAM.length}</span><span class="tm-stat-l">staff, couples and families</span></div>
        <div class="tm-stat"><span class="disp tm-stat-n">{khmer}</span><span class="tm-stat-l">Khmer staff</span></div>
        <div class="tm-stat"><span class="disp tm-stat-n">{nations}</span><span class="tm-stat-l">nations represented</span></div>
      </div>
      <div class="reveal">
        <p class="body" style="margin:0;font-size:18px;">As YWAM Siem Reap, we serve the community, educate youth, develop leaders and train professionals, to see this next generation of youth transform their nation.</p>
        <p class="disp" style="margin:18px 0 0;font-size:clamp(20px,2.2vw,28px);font-weight:500;line-height:1.15;">One nation. One generation.</p>
      </div>
    </div>
  </section>

  {SECTIONS.map(({ title, id, lead, members }) => (
    <section class="sec tm-sec" id={id} style="padding-top:0;">
      <div class="wrap">
        <div class="tm-head reveal">
          <h2 class="disp tm-h2 tm-h2--dept">{title}</h2>
        </div>
        <div class:list={['tm-grid', 'stag', { 'tm-grid--lead': lead }]}>
          {members.map((m, i) => (
            <figure class:list={['tm-person', { 'tm-person--wide': m.kind }]} style={`--i:${i}`}>
              <div class="tm-photo">
                {portrait(m.slug)
                  ? <img src={portrait(m.slug)!} srcset={srcset(portrait(m.slug)!)} sizes={m.kind ? '(max-width: 760px) 100vw, 50vw' : lead ? '(max-width: 760px) 50vw, 33vw' : '(max-width: 760px) 50vw, 25vw'} alt={m.name} loading="lazy" decoding="async" />
                  : <div class="tm-slot"><span class="tm-slot-name">{m.name}</span><span class="tm-slot-hint">Photo coming</span></div>}
                <figcaption class="tm-cap">
                  {m.kind && <span class="tm-kind">{KIND[m.kind]}</span>}
                  <span class="disp tm-name">{m.name}</span>
                  {m.with
                    ? <span class="tm-with">{m.with.map(([who, what]) => <span class="tm-role"><b>{who}</b> · {what}</span>)}</span>
                    : <span class="tm-role">{m.role}</span>}
                </figcaption>
              </div>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="sec sec--paper">
    <div class="wrap reveal" style="text-align:center;">
      <p class="eyebrow">Khmer support</p>
      <h2 class="disp" style="margin:14px auto 0;max-width:22ch;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Invest in the next generation of Khmer missionaries.</h2>
      <p class="body" style="margin:18px auto 0;max-width:54ch;">Our Khmer staff raise their own support to serve here. Meet the ones currently building their support team.</p>
      <a class="btn btn--solid" style="margin-top:28px;display:inline-flex;" href="/give#khmer-staff">Support our Khmer staff</a>
    </div>
  </section>

  <Cta
    title="Want to be on this page?"
    body="Staff join after a DTS. Volunteers come for a few weeks or a few months. Either way, you live and serve with this team."
    primary={['applyStaff', 'Join staff or volunteer']}
    secondary={['contact', 'Get in touch']}
  />
  <Footer />
</SrLayout>

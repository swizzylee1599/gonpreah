---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';
import { TEAM, photo } from '../lib/sr-team';

const leaders = TEAM.filter((m) => m.lead);
const staff = TEAM.filter((m) => !m.lead);
---
<SrLayout title="Our Team | YWAM Siem Reap" noindex
  description="The Khmer and international staff of YWAM Siem Reap: base leaders, DTS and DBS staff, media, music, hospitality, technical and teams.">
  <PageHead eyebrow="Our team" km="ក្រុមការងារ" title="Khmer and international, one team." highlight="one team."
    lead="Forty full-time staff, some here for two years, some for twenty. Every one of them raises their own support and lives in the community." />

  <section class="sec" style="padding-bottom:0;">
    <div class="wrap">
      <p class="eyebrow reveal">Leadership</p>
      <div class="people stag">
        {leaders.map((m) => (
          <figure class={`person${m.name.includes('&') ? ' person--wide' : ''}`}>
            <img src={photo(m)} alt={m.name} loading="lazy" decoding="async" width="640" height="800" />
            <figcaption><span class="disp person-name">{m.name}</span><span class="person-role">{m.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow reveal">Staff</p>
      <div class="people stag">
        {staff.map((m) => (
          <figure class={`person${m.name.includes('&') ? ' person--wide' : ''}`}>
            <img src={photo(m)} alt={m.name} loading="lazy" decoding="async" width="640" height="800" />
            <figcaption><span class="disp person-name">{m.name}</span><span class="person-role">{m.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--paper">
    <div class="wrap reveal" style="text-align:center;">
      <p class="eyebrow">Khmer support</p>
      <h2 class="disp" style="margin:14px auto 0;max-width:22ch;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Invest in the next generation of Khmer missionaries.</h2>
      <p class="body" style="margin:18px auto 0;max-width:54ch;">Our Khmer staff raise their own support to serve here. Meet the ones currently building their support team.</p>
      <a class="btn btn--solid" style="margin-top:28px;display:inline-flex;" href="/give#khmer-staff">Support our Khmer staff</a>
    </div>
  </section>

  <Cta
    title="Want to be on this page?"
    body="Staff join after a DTS. Volunteers come for a few weeks or a few months. Either way, you live and serve with this team."
    primary={['staff', 'Join staff or volunteer']}
    secondary={['contact', 'Get in touch']}
  />
  <Footer />
</SrLayout>

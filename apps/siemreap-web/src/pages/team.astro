---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';

// Staff portraits: swap each entry for { name, role, photo } as they come in.
const TEAM: { name: string; role: string; photo?: string }[] = Array.from({ length: 6 }, () => ({ name: 'Name pending', role: 'Role pending' }));
---
<SrLayout title="Our Team | YWAM Siem Reap"
  description="The Khmer and international staff of YWAM Siem Reap.">
  <PageHead eyebrow="Our team" km="ក្រុមការងារ" title="Khmer and international, one team." highlight="one team."
    lead="Forty full-time staff — some here for two years, some for twenty. Every one of them raises their own support and lives in the community." />
  <section class="sec">
    <div class="wrap grid3 stag">
      {TEAM.map((m) => (
        <div class="card" style="padding:0;overflow:hidden;">
          <div style="height:250px;">
            {m.photo ? <img src={m.photo} alt={m.name} loading="lazy" decoding="async" style="display:block;width:100%;height:100%;object-fit:cover;" /> : <PhotoSlot label="Staff portrait" radius={0} />}
          </div>
          <div style="padding:22px 24px 26px;">
            <p class="disp" style="margin:0;font-size:17px;font-weight:500;">{m.name}</p>
            <p class="muted" style="margin:6px 0 0;font-size:14px;">{m.role}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <Cta
    title="Want to be on this page?"
    body="Staff join after a DTS. Volunteers come for a few weeks or a few months. Either way, you live and serve with this team."
    primary={['staff', 'Join staff or volunteer']}
    secondary={['contact', 'Get in touch']}
  />
  <Footer />
</SrLayout>

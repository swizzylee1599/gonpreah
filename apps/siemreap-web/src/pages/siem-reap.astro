---
import { srcset } from '../lib/sr-img';
import { existsSync } from 'node:fs';
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import Cta from '../components/sr/Cta.astro';
import { TEMPLES, NATURE, PRACTICAL } from '../lib/sr-siemreap';

// The opening: the header photo, then the same view in full colour, then a
// drone shot that circles in on Angkor Wat. Phones get a portrait clip.
const DRONE = '/video/angkor-drone.mp4';
const hasDrone = existsSync('public' + DRONE);
---
<SrLayout title="Things to do in Siem Reap | YWAM Siem Reap" spacer={false}
  description="Angkor Wat, the Bayon and Ta Prohm, then Phnom Kulen and the Tonlé Sap: where students, volunteers, staff and teams go on a day off, plus the practical bits.">

  <!-- 1. Angkor Wat: pinned while scrolling fades the view to colour, flies
       the drone in, then brings up the three temples. -->
  <section class="aw-stack" aria-label="Angkor Wat">
    <div class="aw-pin">
      <img class="aw-still aw-still--muted" src="/images/siemreap/angkor-open-muted.webp" srcset="/images/siemreap/angkor-open-muted-800.webp 800w, /images/siemreap/angkor-open-muted.webp 1600w" sizes="(max-width: 760px) 100vw, 50vw" alt="" decoding="async" fetchpriority="high" />
      <img class="aw-still aw-still--color" src="/images/siemreap/angkor-open.webp" srcset="/images/siemreap/angkor-open-800.webp 800w, /images/siemreap/angkor-open.webp 1600w" sizes="(max-width: 760px) 100vw, 50vw" alt="Angkor Wat rising above the jungle at golden hour" decoding="async" />
      {hasDrone && <video class="aw-video" data-src={DRONE} data-src-mobile={DRONE.replace(/\.mp4$/, '-mobile.mp4')} muted playsinline webkit-playsinline preload="none" aria-hidden="true"></video>}
      <div class="aw-scrim" aria-hidden="true"></div>

      <div class="wrap aw-head">
        <h1 class="disp aw-title">Explore<br /><span style="color:var(--sr-pink);">Siem Reap.</span></h1>
        <p class="muted aw-cue" aria-hidden="true">Scroll ↓</p>
      </div>

      <div class="wrap aw-label" aria-hidden="true">
        <p class="disp aw-n">1.</p>
        <p class="disp aw-name">Angkor<br />Wat</p>
        <p class="km aw-km">អង្គរវត្ត</p>
      </div>

    </div>

    <!-- The temples scroll past on the side while the drone circles behind
         them: each card sits at its own place in the stack, comes up from
         the bottom with the page and leaves at the top. -->
    <div class="aw-side" aria-label="The temples">
      {TEMPLES.map((t, i) => (
        <article class="aw-temple" style={`--k:${i}`}>
          <figure class="aw-temple-photo"><img src={t.photo} srcset={srcset(t.photo)} sizes="(max-width: 760px) 100vw, 30vw" alt={t.alt} loading="lazy" decoding="async" style={t.pos ? `object-position:${t.pos}` : undefined} /></figure>
          <div class="aw-temple-copy">
            <h2 class="disp aw-temple-name"><span class="aw-temple-i">{`1.${i + 1}`}</span> {t.name}</h2>
            <p class="km aw-temple-km">{t.km}</p>
            <p class="body aw-temple-body">{t.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 2. Each day trip is its own full-screen card that flips up over the
       one before and stays put while the next arrives; Good to know last. -->
  <div class="sr-cards">
    {NATURE.map((n, i) => (
      <div class="sr-card" style={`--i:${i + 1}`}>
        <section class="sr-card-face sr-card--photo" aria-label={n.name}>
          <img class="sr-card-bg" src={n.photo} srcset={srcset(n.photo)} sizes="100vw" alt={n.alt} loading="lazy" decoding="async" style={n.pos ? `object-position:${n.pos}` : undefined} />
          <div class="sr-card-scrim" aria-hidden="true"></div>
          <div class="wrap sr-card-copy">
            <p class="eyebrow">{`2.${i + 1}`} · Nature day trips</p>
            <h2 class="disp sr-card-title">{n.name}</h2>
            <p class="km sr-card-km">{n.km}</p>
            <p class="body sr-card-body">{n.body}</p>
          </div>
        </section>
      </div>
    ))}
    <div class="sr-card sr-card--tall" style={`--i:${NATURE.length + 1}`} id="sr-know">
      <section class="sr-card-face sr-card--paper sec--paper" aria-label="Good to know">
        <div class="wrap">
          <p class="eyebrow">3 · Good to know</p>
          <h2 class="disp" style="margin:12px 0 0;font-size:clamp(34px,5vw,72px);font-weight:600;line-height:1;">Before you head out.</h2>
          <dl class="practical sr-know-list">
            {PRACTICAL.map(([k, v]) => (
              <div>
                <dt class="disp">{k}</dt>
                <dd class="body">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </div>
  </div>

  <Cta
    title="Come and see it for yourself."
    body="Siem Reap is home for everyone who trains, serves and visits with us. Find out what living on campus is like."
    primary={['campus', 'Campus life']}
    secondary={['apply', 'Apply']}
  />
  <Footer />
</SrLayout>

<script>
  let ctrl: AbortController | null = null;
  const init = () => {
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const stack = document.querySelector<HTMLElement>('.aw-stack');
    if (!stack) return;
    const pin = stack.querySelector<HTMLElement>('.aw-pin')!;
    const color = stack.querySelector<HTMLElement>('.aw-still--color')!;
    const muted = stack.querySelector<HTMLElement>('.aw-still--muted')!;
    const scrim = stack.querySelector<HTMLElement>('.aw-scrim')!;
    const head = stack.querySelector<HTMLElement>('.aw-head')!;
    const label = stack.querySelector<HTMLElement>('.aw-label')!;
    let video = stack.querySelector<HTMLVideoElement>('.aw-video');
    const cards = [...document.querySelectorAll<HTMLElement>('.sr-card')].map((el) => ({ el, face: el.querySelector<HTMLElement>('.sr-card-face')! }));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const phone = matchMedia('(max-width: 760px)').matches;
    if (reduce) { stack.classList.add('is-static'); video?.remove(); return; }

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (t: number) => t * t * (3 - 2 * t);

    // The drone clip: a portrait one on phones; exact seeks (fastSeek snaps to
    // keyframes); iOS only paints seeks once the clip has played.
    let ready = false, seeking = false, latest = 0, dirty = false;
    const seekTo = (t: number) => {
      latest = t; dirty = true;
      if (seeking || !video) return;
      seeking = true; dirty = false;
      video.currentTime = t;
    };
    if (video) {
      // Fetch the clip only once its section is within a screen of view.
      const startClip = () => {
        video.src = `${(phone && video.dataset.srcMobile) || video.dataset.src}#t=0.001`;
        video.load();
      };
      const near = new IntersectionObserver((en) => { if (en[0].isIntersecting) { near.disconnect(); startClip(); } }, { rootMargin: '100% 0px' });
      near.observe(video); signal.addEventListener('abort', () => near.disconnect());
      let primed = false;
      const prime = () => {
        if (primed || !video) return;
        const pr = video.play();
        if (pr && pr.then) pr.then(() => { primed = true; ready = true; video?.pause(); onScroll(); }).catch(() => {});
      };
      const onData = () => { ready = true; onScroll(); prime(); };
      if (video.readyState >= 2) onData(); else video.addEventListener('loadeddata', onData, { once: true, signal });
      // When autoplay is blocked (Low Power Mode, data saver), the first touch starts it.
      const unlock = () => { if (!primed && video && video.readyState < 2) video.load(); prime(); };
      for (const ev of ['touchstart', 'touchend', 'click']) window.addEventListener(ev, unlock, { passive: true, signal });
      video.addEventListener('seeked', () => { seeking = false; if (dirty) seekTo(latest); }, { signal });
      video.addEventListener('error', () => { video?.remove(); video = null; onScroll(); }, { once: true, signal });
    }

    // Stages across the pinned scroll:
    //   0–.06   the header photo and title hold
    //   .06–.2  the view fades to full colour; the title gives way to "1. Angkor Wat"
    //   .2–.95  the drone circles slowly around the temple while the temple
    //           cards scroll past on the side (they are in the page flow,
    //           so they track the finger exactly)
    const measure = () => {
      const r = stack.getBoundingClientRect();
      const scrollable = r.height - pin.offsetHeight;
      return scrollable <= 0 ? 0 : clamp01(-r.top / scrollable);
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const p = measure();

      const c = ease(clamp01((p - 0.06) / 0.14));
      color.style.opacity = String(c);
      muted.style.opacity = String(1 - c * 0.999);

      const fly = clamp01((p - 0.2) / 0.75);
      if (video && ready && video.duration && !Number.isNaN(video.duration)) {
        video.style.opacity = p > 0.19 ? '1' : '0';
        if (p > 0.19) seekTo(fly * video.duration * 0.99);
      } else if (video) {
        // Until the clip can play, the colour still simply holds: no push-in.
        video.style.opacity = '0';
      }

      scrim.style.opacity = String(0.55 - 0.3 * c);

      const hOut = ease(clamp01((p - 0.07) / 0.09));
      head.style.opacity = String(1 - hOut);
      head.style.transform = `translateY(${(-30 * hOut).toFixed(1)}px)`;

      // "1. Angkor Wat" slides in from the left. On phones it then docks
      // small in the top-left corner before the temple cards scroll through;
      // on desktop it stays large on the left while the cards pass on the right.
      const lIn = ease(clamp01((p - 0.12) / 0.08));
      const lUp = phone ? ease(clamp01((p - 0.2) / 0.06)) : 0;
      const dockY = 96 - label.offsetTop;
      label.style.opacity = String(lIn);
      label.style.transform = `translate(${((1 - lIn) * -40).toFixed(1)}px, ${(dockY * lUp).toFixed(1)}px) scale(${(1 - 0.5 * lUp).toFixed(3)})`;

      // 2. Each card flips up as it arrives, like the cards on Campus Life,
      // then sticks while the next one comes up over it.
      for (const { el, face } of cards) {
        const t = clamp01(1 - el.getBoundingClientRect().top / window.innerHeight);
        const e = ease(t);
        face.style.transform = e >= 1 ? 'none' : `perspective(1600px) rotateX(${((1 - e) * 24).toFixed(2)}deg) scale(${(0.92 + 0.08 * e).toFixed(3)})`;
        face.style.borderRadius = `${Math.round((1 - e) * 26)}px`;
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { signal });
    update();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

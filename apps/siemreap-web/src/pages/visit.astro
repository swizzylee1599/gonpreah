---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import CardGrid from '../components/sr/CardGrid.astro';
import Cta from '../components/sr/Cta.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';
---
<SrLayout title="Bring a Team | YWAM Siem Reap">
  <PageHead eyebrow="Visit / short-term teams" km="មកលេង" title="Bring a team" highlight="team"
    lead="Teams that come here work alongside Khmer staff on projects that continue after you leave." />
  <section class="sec">
    <div class="wrap" style="display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center;">
      <div style="height:400px;"><PhotoSlot label="Outreach or team photo" /></div>
      <div>
        <h2 class="disp" style="margin:0;font-size:30px;font-weight:500;">What a trip looks like</h2>
        <p class="body" style="margin-top:18px;">Most teams stay one to three weeks: village work in the mornings, teaching or children's programs in the afternoons, debrief in the evenings. You stay on or near the base and eat with the community.</p>
        <p class="body" style="margin-top:16px;">We will not build a trip around photographs. If a project does not need your team, we will tell you and suggest something that does.</p>
        <a class="btn btn--solid" style="margin-top:28px;display:inline-flex;" href="/contact">Enquire about dates</a>
      </div>
    </div>
  </section>
  <CardGrid items={[
    ['Village outreach', 'Working with Khmer leaders in villages around Siem Reap.'],
    ['Children & youth', 'Programs with schools and community groups.'],
    ['Practical projects', 'Building, repair and site work on the base and in villages.'],
  ]} />
  <Cta
    title="Campus life"
    body="What living here is like — community, meals, worship — and what Siem Reap has to offer when the day is done."
    primary={['campus', 'See campus life']}
    secondary={['contact', 'Ask us anything']}
  />
  <Footer />
</SrLayout>

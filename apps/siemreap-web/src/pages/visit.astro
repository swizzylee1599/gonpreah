---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';
import { PORTAL } from '../lib/sr-routes';
import { CONTACT } from '../lib/sr-contact';
import { srcset } from '../lib/sr-img';

// Bring a team. The content follows the Guide for Short-term Teams that the
// base sends every team; the full guide is linked for download.
const GUIDE = '/ywam-siem-reap-team-guide.pdf';

const SERVE = [
  { title: 'Sharing the gospel', body: 'Testimonies, house visits in the villages and youth events: many chances to share the love of Jesus and bring the gospel to the unreached.', photo: '/images/schools/outreach-kids-friends.webp', pos: '50% 30%' },
  { title: 'Supporting ministries', body: 'Teams support the ministries we partner with in Siem Reap: education, children’s ministry, food distribution and construction.', photo: '/images/schools/outreach-kids-courtyard.webp', pos: '50% 60%' },
  { title: 'Skills', body: 'Worship, media, barista, kitchen and technical skills empower and inspire our staff while supporting the ministries.', photo: '/images/campus/building-stairs.webp', pos: '55% 40%' },
  { title: 'Encouraging missionaries', body: 'Teams work alongside our staff, bringing fresh energy, prayer and support to those serving long term, and often keep praying and giving after they go home.', photo: '/images/campus/community-night.webp' },
];

const PREP: [string, string][] = [
  ['Worship and prayer', 'Your journey starts with prayer. Worship and prayer bring unity, strength and guidance, and prepare your heart for what is ahead.'],
  ['Ministry prep', 'Be ready to share your story. Come prepared with songs, dances, skits and games: they are some of the best ways to connect with Khmer people.'],
  ['Culture, language, awareness', 'Learn a few Khmer phrases and something of Cambodia’s history and traditions. It shows respect and opens doors.'],
  ['The right mindset', 'Come with a heart to serve. You are here to support long-term missions. Things will not always go as planned, so be FAT: flexible, adaptable and teachable.'],
];

const PACK: string[] = [
  'Shoes you do not mind getting dirty, and sandals',
  'Towels (bedding and pillows are provided, towels are not)',
  'A water bottle',
  'Sunscreen, lots of it',
  'Your own toiletries (familiar brands are hard to find)',
  'Mosquito spray, especially in rainy season',
  'A raincoat in rainy season',
  'A passport valid at least six months after arrival',
];


const DRESS: [string, string][] = [
  ['Teaching', 'Semi-professional: skirts or tidy long pants with a nice shirt; slacks and a polo or button-up for men.'],
  ['Ministry', 'Jeans or tidy long pants, or capris past the knee. T-shirts are fine. No Thai elephant pants for ministry.'],
  ['Sport and dirty work', 'Long basketball shorts to the knee. No short running shorts.'],
  ['Out of hours', 'T-shirts, long shorts or any pants. In your room, whatever you like.'],
  ['Swimming', 'Khmer women swim in shorts and a T-shirt, so we do too; men wear trunks to the knee.'],
  ['Also', 'Dresses and skirts below the knee or with leggings. Long sleeves keep you cooler in the sun. Keep tattoos low-key; no new tattoos or piercings on outreach.'],
];

const BASE: [string, string][] = [
  ['Meals', 'Breakfast 7:30, lunch 12:30, dinner 6:30 on weekdays and Sunday night; a bell rings. Tell your coordinator if you will eat out or bring guests.'],
  ['Quiet hours', '9:30pm to 7:30am. The gate locks at 9:30pm; let someone know if you will be late.'],
  ['Rooms', 'No toilet paper down the toilet, no shoes in the bedrooms, no food in rooms, and AC at 22° or above. Last one out turns off lights and AC.'],
  ['Getting around', 'Teams do not drive cars or motos; bicycles are fine. Wear a helmet as a moto passenger. PassApp or Grab for tuk-tuks: a ride is usually $1 to $2.50.'],
  ['Drinking and smoking', 'Not allowed on base or out.'],
];

const PRACTICAL: [string, string][] = [
  ['Airport', 'Siem Reap Angkor International (SAI), about an hour from the base. Transfer: $25 car (4), $30 van (12), $35 van (15).'],
  ['Seasons', 'Dry November to April; cool and busiest November to February; March and April up to 42°C. Rainy May to October, usually an hour or two a day.'],
  ['Money', 'Riel and US dollars; 4,000 riel to the dollar. Change money at Wing booths, with clean, unripped notes.'],
  ['Vaccinations', 'Hepatitis B, tetanus (up to date) and typhoid are required.'],
  ['Time zone', 'Indochina Time (ICT), UTC+7.'],
  ['Visas and housing', 'The e-visa guide and your letter of invitation come through the GP Portal once your team is accepted. Ask the teams coordinator about anything else.'],
];
---
<SrLayout title="Bring a Team | YWAM Siem Reap" spacer={false}
  description="Bring a short-term team to YWAM Siem Reap. How teams serve, how to prepare, what to pack, the dress code, life on base and the practical details, from the guide we send every team.">
  <PageHead eyebrow="Visit / short-term teams" km="មកលេង" title="Bring a team" highlight="team"
    lead="Teams that come here work alongside Khmer staff on projects that continue after you leave."
    photo="/images/campus/team-market.webp" photoPos="50% 35%" full center
    photoAlt="A visiting team in Khmer skirts laughing together at a market of thatched stalls" />

  <section class="sec">
    <div class="wrap visit-intro">
      <div class="visit-intro-photo wipe"><img src="/images/campus/visitors-angkor.webp" srcset={srcset('/images/campus/visitors-angkor.webp')} sizes="(max-width: 760px) 100vw, 50vw" alt="Two young men grinning from behind a stone pillar at Angkor Wat" loading="lazy" decoding="async" /></div>
      <div class="reveal">
        <p class="eyebrow">Welcome to your adventure</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Thank you for your yes, and your heart for Cambodia.</h2>
        <p class="body" style="margin-top:18px;">We believe God has a purpose for your time here. As a short-term team you serve alongside us in villages, schools, churches and communities, sharing the gospel in word and action. Siem Reap is known for Angkor Wat; it is also home to many who have never heard the name of Jesus.</p>
        <p class="body" style="margin-top:16px;">Most teams stay one to three weeks. You stay on campus, eat with the community, and work with Khmer staff on things that continue after you leave.</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:28px;">
          <a class="btn btn--solid" href="/apply?school=team">Apply to bring a team</a>
          <a class="btn" href={GUIDE} target="_blank" rel="noopener">Download the team guide (PDF)</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="sr-jump" aria-label="On this page">
    <div class="wrap sr-jump-row">
      <a href="#serve">How teams serve</a><a href="#prep">Before the trip</a><a href="#dress">Dress</a><a href="#base">On base</a><a href="#practical">Practical</a><a href="#how">How to apply</a>
    </div>
  </nav>

  <section class="sec" id="serve">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">How teams serve</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Part of something bigger.</h2>
        <p class="body" style="margin-top:18px;max-width:60ch;">Short-term teams play a real part in YWAM Cambodia’s vision of One Nation, One Generation: raising up a generation of Khmer believers to transform their nation. Your time here impacts lives, and it strengthens the local believers who carry on the work.</p>
      </div>
      <div class="serve-grid stag">
        {SERVE.map((s) => (
          <article class="serve-item">
            <figure class="serve-photo"><img src={s.photo} srcset={srcset(s.photo)} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="lazy" decoding="async" style={s.pos ? `object-position:${s.pos}` : undefined} /></figure>
            <h3 class="disp" style="margin:18px 0 0;font-size:22px;font-weight:500;">{s.title}</h3>
            <p class="body" style="margin:10px 0 0;font-size:16px;">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="prep">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Before the trip</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Spiritual and practical preparation.</h2>
      </div>
      <div class="prep-grid stag">
        {PREP.map(([t, d]) => (
          <div class="prep-item"><h3 class="disp" style="margin:0;font-size:20px;font-weight:600;">{t}</h3><p class="body" style="margin:10px 0 0;font-size:15px;">{d}</p></div>
        ))}
      </div>
      <div class="pack reveal">
        <h3 class="disp" style="margin:0;font-size:22px;font-weight:600;">Packing essentials</h3>
        <ul class="pack-list">{PACK.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;" id="dress">
    <div class="wrap">
      <div class="card reveal">
        <p class="eyebrow">Dress code</p>
        <h2 class="disp" style="margin:12px 0 0;font-size:clamp(26px,3vw,40px);font-weight:500;line-height:1.1;">Modest is hottest.</h2>
        <p class="body" style="margin:14px 0 0;max-width:60ch;font-size:15px;">Ministry time is semi-professional; the rest of the time, still appropriate when you are out of the house, right up to the day you leave.</p>
        <dl class="practical sr-know-list">
          {DRESS.map(([k, v]) => <div><dt class="disp">{k}</dt><dd class="body">{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="base">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Base guide</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Our home is your home.</h2>
        <p class="body" style="margin-top:18px;max-width:58ch;">The base houses long-term staff and families with children, so we ask every team to help us steward it well.</p>
      </div>
      <dl class="practical sr-know-list reveal" style="margin-top:30px;">
        {BASE.map(([k, v]) => <div><dt class="disp">{k}</dt><dd class="body">{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec" id="practical">
    <div class="wrap">
      <div class="card reveal">
        <p class="eyebrow">Practical information</p>
        <h2 class="disp" style="margin:12px 0 0;font-size:clamp(26px,3vw,40px);font-weight:500;line-height:1.1;">Before you fly.</h2>
        <dl class="practical sr-know-list">
          {PRACTICAL.map(([k, v]) => <div><dt class="disp">{k}</dt><dd class="body">{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;" id="how">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">From first message to the week itself.</h2>
      </div>
      <div class="apply-steps" style="margin-top:34px;">
        {[
          ['Tell us about your team', 'Your church or base, rough dates, and how many are coming. The team leader applies once for everyone on the GP Portal.'],
          ['We plan it together', 'Dates, the villages and ministries you would serve in, where you stay and the budget. We confirm we can host you.'],
          ['Register and prepare', 'Passport copies, a team photo, flights when booked. Then the e-visa guide, our letter of invitation, and this guide.'],
          ['Arrive', 'We collect you from Siem Reap airport, settle you in, and walk through the week together on the first evening.'],
        ].map(([t, d], n) => (
          <div class="apply-step reveal">
            <span class="disp" style="font-size:32px;color:var(--sr-pink);font-weight:500;">{'0' + (n + 1)}</span>
            <div>
              <h3 class="disp" style="margin:0;font-size:22px;font-weight:500;">{t}</h3>
              <p class="body" style="margin:12px 0 0;max-width:56ch;font-size:16px;">{d}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:32px;">
        <a class="btn btn--solid" href={PORTAL} target="_blank" rel="noopener">Apply on the GP Portal ↗︎</a>
        <a class="btn" href={`mailto:${CONTACT.email}?subject=${encodeURIComponent('Bringing a team')}`}>Email {CONTACT.email}</a>
        <a class="btn btn--plain" href={GUIDE} target="_blank" rel="noopener">Team guide (PDF)</a>
      </div>
    </div>
  </section>

  <Cta
    title="Campus life"
    body="What living here is like: community, meals, worship, and what Siem Reap has to offer when the day is done."
    primary={['campus', 'See campus life']}
    secondary={['team', 'Meet the team']}
  />
  <Footer />
</SrLayout>

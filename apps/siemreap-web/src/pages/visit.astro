---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';
import { PORTAL } from '../lib/sr-routes';
import { CONTACT } from '../lib/sr-contact';
import { srcset } from '../lib/sr-img';

// Bring a team. The facts a team leader decides on (cost, what it includes,
// where teams stay) are drafts marked "to confirm" until the base confirms them.
const SERVE = [
  { title: 'Village outreach', body: 'Working with Khmer leaders in the villages around Siem Reap: visits, English, games, and the gospel, on their invitation.', photo: '/images/schools/outreach-kids-friends.webp', pos: '50% 30%' },
  { title: 'Children & youth', body: 'Programs with schools and community groups: songs, stories, sport and English for the kids who turn up every afternoon.', photo: '/images/schools/outreach-kids-courtyard.webp', pos: '50% 60%' },
  { title: 'Practical projects', body: 'Building, painting, repair and site work on the base and in villages. Bring a trade and we will use it.', photo: '/images/campus/building-stairs.webp', pos: '55% 40%' },
  { title: 'Campus and worship', body: 'Join the community for worship nights, community night on Thursdays, and the life of the base in between.', photo: '/images/campus/community-night.webp' },
];

const WEEK: [string, string][] = [
  ['7:00', 'Breakfast with the community'],
  ['8:30', 'Base worship, then out to the village or the project'],
  ['12:00', 'Lunch, usually back on campus'],
  ['14:00', "Afternoon program: kids, English, or the project again"],
  ['18:00', 'Dinner together'],
  ['19:30', 'Team debrief; Thursdays are community night'],
];

const KNOW: [string, string][] = [
  ['Length', 'One to three weeks. Most teams come for ten to fourteen days.'],
  ['Team size', 'Six to twenty people, with at least one leader. Ask us about larger teams.'],
  ['Where you stay', 'On campus, in shared rooms, with the community. Meals are included.'],
  ['Cost', 'To confirm: a per-person daily rate that covers your room, meals and local transport. Flights, visas and travel insurance are extra.'],
  ['When to book', 'Three to six months ahead. We host teams year round; November to February is the coolest season.'],
  ['Visas', "Most nationalities get a Cambodian e-visa online. The step-by-step guide appears in the GP Portal once your team is accepted."],
];

const FAQ: [string, string][] = [
  ['Who can bring a team?', 'Churches, youth groups, YWAM bases, schools and families. The team leader applies once for everyone through the GP Portal.'],
  ['Do we need to speak Khmer?', 'No. Khmer staff work alongside you and translate. Learning a few words goes a long way, and we will teach you.'],
  ['What do we do on the weekend?', 'Saturday is Sabbath on campus. Sunday is church with the community. The temples of Angkor are twenty minutes away, and we will help you plan a day there.'],
  ['Is it safe?', 'Siem Reap is a calm, friendly city and the base is a known part of its community. You travel with our staff, and we brief every team on the culture and the practicalities before you come.'],
  ['What should we bring?', 'Modest, light clothing (shoulders and knees covered for temples and villages), closed shoes for work days, a refillable water bottle, and any supplies for the program you are running. We send a full packing list once you are booked.'],
];
---
<SrLayout title="Bring a Team | YWAM Siem Reap" spacer={false}
  description="Bring a short-term team to YWAM Siem Reap: one to three weeks of village outreach, children's programs and practical projects alongside Khmer staff. What a week looks like, what it costs, and how to book.">
  <PageHead eyebrow="Visit / short-term teams" km="មកលេង" title="Bring a team" highlight="team"
    lead="Teams that come here work alongside Khmer staff on projects that continue after you leave."
    photo="/images/campus/team-market.webp" photoPos="50% 35%" full center
    photoAlt="A visiting team in Khmer skirts laughing together at a market of thatched stalls" />

  <section class="sec">
    <div class="wrap visit-intro">
      <div class="visit-intro-photo wipe"><img src="/images/campus/visitors-angkor.webp" srcset={srcset('/images/campus/visitors-angkor.webp')} sizes="(max-width: 760px) 100vw, 50vw" alt="Two young men grinning from behind a stone pillar at Angkor Wat" loading="lazy" decoding="async" /></div>
      <div class="reveal">
        <p class="eyebrow">What a trip looks like</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Alongside the community, not around it.</h2>
        <p class="body" style="margin-top:18px;">Most teams stay one to three weeks: village work in the mornings, teaching or children's programs in the afternoons, debrief in the evenings. You stay on campus and eat with the community.</p>
        <p class="body" style="margin-top:16px;">We will not build a trip around photographs. If a project does not need your team, we will tell you and suggest something that does.</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:28px;">
          <a class="btn btn--solid" href="/apply?school=team">Apply to bring a team</a>
          <a class="btn" href="/contact">Ask about dates</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;" id="serve">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Where teams serve</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">Four kinds of week.</h2>
      </div>
      <div class="serve-grid stag">
        {SERVE.map((s) => (
          <article class="serve-item">
            <figure class="serve-photo"><img src={s.photo} srcset={srcset(s.photo)} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="lazy" decoding="async" style={s.pos ? `object-position:${s.pos}` : undefined} /></figure>
            <h3 class="disp" style="margin:18px 0 0;font-size:22px;font-weight:500;">{s.title}</h3>
            <p class="body" style="margin:10px 0 0;font-size:16px;">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="week">
    <div class="wrap visit-week">
      <div class="reveal">
        <p class="eyebrow">A day with a team</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">The shape of a day.</h2>
        <p class="body" style="margin-top:18px;max-width:46ch;">Every day starts and ends with the community. The middle is yours: the village, the kids, or the project.</p>
      </div>
      <ol class="day-list reveal">
        {WEEK.map(([t, d]) => (
          <li><span class="disp day-time">{t}</span><span class="body">{d}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" id="know">
    <div class="wrap">
      <div class="card reveal">
        <p class="eyebrow">Good to know</p>
        <h2 class="disp" style="margin:12px 0 0;font-size:clamp(26px,3vw,40px);font-weight:500;line-height:1.1;">Before you plan.</h2>
        <dl class="practical sr-know-list">
          {KNOW.map(([k, v]) => (
            <div>
              <dt class="disp">{k}</dt>
              <dd class="body">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;" id="how">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.1;">From first message to the week itself.</h2>
      </div>
      <div class="apply-steps" style="margin-top:34px;">
        {[
          ['Tell us about your team', 'Your church or base, rough dates, and how many are coming. The team leader applies once for everyone on the GP Portal.'],
          ['We plan it together', 'Dates, the villages and ministries you would serve in, where you stay and the budget. We confirm we can host you.'],
          ['Register and prepare', 'Passport copies, a team photo, flights when booked. Then the e-visa guide, our letter of invitation, a packing list and a culture briefing.'],
          ['Arrive', 'We collect you from Siem Reap airport, settle you in, and walk through the week together on the first evening.'],
        ].map(([t, d], n) => (
          <div class="apply-step reveal">
            <span class="disp" style="font-size:32px;color:var(--sr-pink);font-weight:500;">{'0' + (n + 1)}</span>
            <div>
              <h3 class="disp" style="margin:0;font-size:22px;font-weight:500;">{t}</h3>
              <p class="body" style="margin:12px 0 0;max-width:56ch;font-size:16px;">{d}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:32px;">
        <a class="btn btn--solid" href={PORTAL} target="_blank" rel="noopener">Apply on the GP Portal ↗︎</a>
        <a class="btn" href={`mailto:${CONTACT.email}?subject=${encodeURIComponent('Bringing a team')}`}>Email {CONTACT.email}</a>
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="faq">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">FAQ</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(28px,3.4vw,44px);font-weight:500;line-height:1.12;">Questions teams ask</h2>
      </div>
      <div class="faq stag" style="margin-top:34px;">
        {FAQ.map(([q, a]) => (
          <details class="faq-item">
            <summary class="disp">{q}<span class="faq-mark" aria-hidden="true"></span></summary>
            <p class="body" style="margin:0;padding:0 0 24px;max-width:66ch;font-size:16px;">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta
    title="Campus life"
    body="What living here is like — community, meals, worship — and what Siem Reap has to offer when the day is done."
    primary={['campus', 'See campus life']}
    secondary={['contact', 'Ask us anything']}
  />
  <Footer />
</SrLayout>

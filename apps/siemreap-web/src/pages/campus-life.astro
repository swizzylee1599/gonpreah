---
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import Cta from '../components/sr/Cta.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';
import CampusDive from '../components/sr/CampusDive.astro';

const STATS: { n: number; suffix: string; label: string }[] = [
  { n: 40, suffix: '', label: 'full-time staff' },
  { n: 4, suffix: '', label: 'schools on campus' },
  { n: 1, suffix: '', label: 'campus, one family' },
  { n: 20, suffix: ' min', label: 'to Angkor Wat' },
];

// The base week. Every weekday shares the same frame; the 8:30 slot changes.
type Slot = { time: string; title: string; note?: string; hi?: boolean };
const WEEK: { day: string; full: string; slots: Slot[] }[] = [
  { day: 'Mon', full: 'Monday', slots: [
    { time: '7:30 – 8:00', title: 'Breakfast' }, { time: '8:00', title: 'Morning chores' },
    { time: '8:30 – 9:30', title: 'Base worship', note: 'The whole base, one room, in Khmer and English.', hi: true },
    { time: '12:30 – 1:30', title: 'Lunch' }, { time: '6:30 – 7:30', title: 'Dinner' },
  ] },
  { day: 'Tue', full: 'Tuesday', slots: [
    { time: '7:30 – 8:00', title: 'Breakfast' }, { time: '8:00', title: 'Morning chores' },
    { time: '8:30 – 9:30', title: 'Staff meeting', note: 'Where the week gets planned and prayed over.', hi: true },
    { time: '12:30 – 1:30', title: 'Lunch' }, { time: '6:30 – 7:30', title: 'Dinner' },
  ] },
  { day: 'Wed', full: 'Wednesday', slots: [
    { time: '7:30 – 8:00', title: 'Breakfast' }, { time: '8:00', title: 'Morning chores' },
    { time: '8:30 – 9:30', title: 'Intercession', note: 'Praying for Cambodia, the nations, and each other.', hi: true },
    { time: '12:30 – 1:30', title: 'Lunch' }, { time: '6:30 – 7:30', title: 'Dinner' },
  ] },
  { day: 'Thu', full: 'Thursday', slots: [
    { time: '7:30 – 8:00', title: 'Breakfast' }, { time: '8:00', title: 'Morning chores' },
    { time: '8:30 – 9:30', title: 'Small groups', note: 'A few people, honest conversation, prayer.', hi: true },
    { time: '12:30 – 1:30', title: 'Lunch' },
    { time: '6:15 – 7:30', title: 'Community night', note: 'Everyone together — worship, stories, food after.', hi: true },
    { time: '7:30 – 8:30', title: 'Dinner', note: 'Later on Thursdays, after community night.' },
  ] },
  { day: 'Fri', full: 'Friday', slots: [
    { time: '7:30 – 8:00', title: 'Breakfast' }, { time: '8:00', title: 'Morning chores' },
    { time: '8:30 – 9:30', title: 'Staff development', note: 'Training and growth for the staff team.', hi: true },
    { time: '12:30 – 1:30', title: 'Lunch' }, { time: '6:30 – 7:30', title: 'Dinner' },
  ] },
  { day: 'Sat', full: 'Saturday', slots: [
    { time: 'All day', title: 'Sabbath', note: 'A day of rest for the whole base. No chores, no meetings — sleep, the city, a slow meal.', hi: true },
  ] },
  { day: 'Sun', full: 'Sunday', slots: [
    { time: 'Morning', title: 'Church', note: 'Everyone joins a local congregation — Khmer and international churches around Siem Reap.', hi: true },
  ] },
];

const WHO: [string, string][] = [
  ['Students', 'DTS and DBS students live on campus for the length of their school, in shared rooms with classmates.'],
  ['Volunteers', 'Short or long term, volunteers live and eat with the community and join its rhythms while they serve.'],
  ['New staff', 'Staff joining us find their feet here first: language, community, city — before the work takes over.'],
  ['Teams', 'Visiting teams stay on or near the base, eat with us, and see what living here is actually like.'],
];

// Siem Reap for people who are coming to live here for a while, not just
// pass through. One panel per kind of day off, plus the practical one.
type Place = { name: string; note: string };
type Panel = { title: string; km: string; intro: string; places: Place[]; label: string; photo?: string; alt?: string; pos?: string };
const CITY: Panel[] = [
  {
    title: 'Temples & history', km: 'អង្គរ',
    intro: 'Siem Reap is the gateway to Angkor. The temples are twenty minutes from the base and you will want more than one visit.',
    places: [
      { name: 'Angkor Wat at sunrise', note: 'The one everyone comes for. Go early, stay for the quiet after the crowds leave.' },
      { name: 'Angkor Thom & the Bayon', note: 'The walled city and its temple of two hundred stone faces.' },
      { name: 'Ta Prohm', note: 'The temple the jungle took back — roots over stone.' },
      { name: 'Banteay Srei', note: 'Smaller, further out, and the finest carving in Angkor.' },
      { name: 'Angkor National Museum', note: 'Worth an afternoon before or after the temples themselves.' },
    ],
    label: 'Drop a photo — Angkor Wat', photo: '/images/campus/angkor-backpack.jpg', alt: 'A student with a backpack looking up at the towers of Angkor Wat', pos: '60% 50%',
  },
  {
    title: 'Food & cafés', km: 'ម្ហូប',
    intro: 'Khmer food is gentler than Thai — sour, herby, coconut-sweet. Learn three dishes and you will eat well anywhere.',
    places: [
      { name: 'Fish amok', note: 'Steamed fish curry in banana leaf. Order it your first week.' },
      { name: 'Num banh chok', note: 'Khmer noodles for breakfast, from a lady with a basket, before 9am.' },
      { name: 'Old Market (Psar Chas)', note: 'Fruit, fabric, coffee, everything. Bargain gently.' },
      { name: 'Kandal Village', note: 'Small streets of cafés and shops a short walk from the river.' },
      { name: 'Night markets & Pub Street', note: 'Loud, bright, cheap, and a good place to take a visiting team for one evening.' },
    ],
    label: 'Drop a photo — a market or café', photo: '/images/campus/fruit-table.jpg', alt: 'Trays of watermelon, grapes and longan being served at a shared meal', pos: '50% 50%',
  },
  {
    title: 'Nature & day trips', km: 'ធម្មជាតិ',
    intro: 'When you need space, the countryside starts ten minutes out of town.',
    places: [
      { name: 'Tonlé Sap floating villages', note: 'Kampong Phluk or Kampong Khleang — stilt houses and flooded forest, best in the wet season.' },
      { name: 'Phnom Kulen', note: 'Waterfalls, a reclining Buddha, and the river of a thousand lingas. A full day.' },
      { name: 'Countryside by bicycle', note: 'Rice fields, water buffalo and villages on the road out of town.' },
      { name: 'Sunset from Pre Rup', note: 'Or Phnom Bakheng — both inside the Angkor park.' },
    ],
    label: 'Drop a photo — Tonlé Sap or Kulen', photo: '/images/campus/tonle-sap-boat.jpg', alt: 'A blue two-deck tour boat full of passengers crossing the Tonlé Sap under a wide sky', pos: '50% 55%',
  },
  {
    title: 'Culture & evenings', km: 'វប្បធម៌',
    intro: 'Siem Reap has more going on after dark than any city its size in Cambodia.',
    places: [
      { name: 'Phare, the Cambodian Circus', note: 'Acrobatics and storytelling by young Khmer performers. Take everyone.' },
      { name: 'Apsara dance', note: 'Classical Khmer dance, usually with dinner.' },
      { name: 'Made in Cambodia market', note: 'Local makers, fair prices, good gifts to send home.' },
      { name: 'Local churches', note: 'Khmer and international congregations — ask staff where they worship on Sundays.' },
    ],
    label: 'Drop a photo — Phare or an evening out', photo: '/images/campus/apsara.jpg', alt: 'An Apsara dancer in gold costume performing on stage', pos: '50% 30%',
  },
];

const PRACTICAL: [string, string][] = [
  ['Getting around', 'Tuk-tuks everywhere. Use PassApp or Grab for a fair price.'],
  ['Money', 'US dollars and Khmer riel. Change comes back in riel.'],
  ['Phone', 'Get a local SIM on arrival. Campus has wifi.'],
  ['Weather', 'Cool Nov–Feb, hot Mar–May, rainy Jun–Oct.'],
  ['Dress', 'Cover shoulders and knees at temples.'],
  ['Health', 'Drink filtered water. Clinics in town.'],
];
---
<SrLayout title="Campus Life | YWAM Siem Reap" spacer={false}
  description="What living at YWAM Siem Reap is like — Khmer and international, students, volunteers, staff and teams in one community — and what to do in Siem Reap when the day is done.">
  <CampusDive aerial="/images/campus/campus-aerial-wide.jpg" front="/images/campus/campus-front.jpg"
    statement="Live in a cross‑cultural community centered around Jesus."
    sub="YWAM Siem Reap is a community of young people on fire for Jesus and making His name known."
    photos={[
      { src: '/images/campus/friends-temple.jpg', alt: 'Two friends, one international and one Khmer, talking among temple stones', pos: '50% 35%' },
      { src: '/images/gonpreah-worship-1.jpg', alt: 'Students worshipping together on campus' },
      { src: '/images/campus/high-five.jpg', alt: 'A visiting student high-fiving a laughing girl in a village', pos: '50% 40%' },
      { src: '/images/campus/work-bamboo.jpg', alt: 'A young man carrying bamboo poles along a campus path', pos: '50% 30%' },
    ]} />

  <section class="ride-stack" id="siem-reap" aria-label="Explore Siem Reap">
    <div class="ride-pin">
      <div class="ride-card">
        <div class="ride-plate is-first" role="img" aria-label="The road ahead from the back of a tuk-tuk in Siem Reap" style="background-image:url(/images/campus/tuktuk.jpg)"></div>
        {CITY.map((g) => g.photo
          ? <div class="ride-plate" role="img" aria-label={g.alt ?? ''} style={`background-image:url(${g.photo});background-position:${g.pos ?? '50% 50%'}`}></div>
          : <div class="ride-plate"><PhotoSlot label={g.label} radius={0} /></div>)}
        <img class="ride-frame" src="/images/campus/tuktuk-frame.webp" alt="" aria-hidden="true" decoding="async" />
        <div class="ride-shade" aria-hidden="true"></div>

        <div class="wrap ride-intro">
          <p class="eyebrow">Siem Reap</p>
          <h2 class="disp ride-title">Explore<br />Siem Reap.</h2>
          <p class="body ride-lead">Hop in. This is where we take students, volunteers, staff and teams on a day off.</p>
          <p class="muted ride-cue" aria-hidden="true">Scroll ↓</p>
        </div>

        <ol class="ride-marks" aria-hidden="true">
          <li class="ride-mark is-on"><span>Explore</span></li>
          {CITY.map((g) => <li class="ride-mark"><span>{g.title}</span></li>)}
          <li class="ride-mark"><span>Good to know</span></li>
        </ol>

        <div class="ride-info">
          {CITY.map((g, i) => (
            <article class="ride-stop">
              <p class="disp ride-stop-n">{'0' + (i + 1)} · {'0' + (CITY.length + 1)}</p>
              <h3 class="disp ride-stop-title">{g.title}</h3>
              <p class="body ride-stop-intro">{g.intro}</p>
              <ul class="ride-list">
                {g.places.map((pl) => <li><b>{pl.name}</b><span>{pl.note}</span></li>)}
              </ul>
            </article>
          ))}
          <article class="ride-stop ride-stop--practical">
            <p class="disp ride-stop-n">{'0' + (CITY.length + 1)} · {'0' + (CITY.length + 1)}</p>
            <h3 class="disp ride-stop-title">Good to know</h3>
            <dl class="practical">
              {PRACTICAL.map(([k, v]) => (
                <div>
                  <dt class="disp">{k}</dt>
                  <dd class="body">{v}</dd>
                </div>
              ))}
            </dl>
          </article>
        </div>
      </div>
    </div>
  </section>


  <section class="cl-stats" aria-label="Campus in numbers">
    <div class="wrap cl-stats-grid">
      {STATS.map((s) => (
        <div class="cl-stat io-in">
          <p class="disp cl-stat-n"><span data-count={s.n}>0</span>{s.suffix}</p>
          <p class="muted cl-stat-l">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec cl-sched-sec" id="schedule">
    <div class="wrap cl-hs-head">
      <div class="reveal">
        <p class="eyebrow">Base schedule</p>
        <h2 class="disp" style="margin:12px 0 0;font-size:clamp(28px,3.4vw,46px);font-weight:500;line-height:1.08;">The shape of a week.</h2>
        <p class="body" style="margin:14px 0 0;max-width:52ch;">Every weekday starts with breakfast and chores together. What comes next at 8:30 depends on the day.</p>
      </div>
      <div class="sched-side">
        <figure class="sched-night reveal">
          <img src="/images/campus/community-night.jpg" alt="Community night: the base worshipping together under string lights" loading="lazy" decoding="async" />
          <figcaption class="muted">Community night, every Thursday</figcaption>
        </figure>
        <div class="cl-hs-nav" aria-hidden="true">
          <button type="button" class="cl-hs-btn" data-hs-prev="sched">←</button>
          <button type="button" class="cl-hs-btn" data-hs-next="sched">→</button>
        </div>
      </div>
    </div>
    <div class="cl-hs" data-hs="sched">
      <p class="disp cl-hs-label" aria-hidden="true">Base<br />schedule</p>
      <ol class="cl-hs-track sched-track">
        {WEEK.map((d) => (
          <li class="sched-day io-in">
            <p class="disp sched-day-n">{d.day}</p>
            <p class="muted sched-day-f">{d.full}</p>
            <ul class="sched-slots">
              {d.slots.map((sl) => (
                <li class={`sched-slot${sl.hi ? ' is-hi' : ''}`}>
                  <span class="sched-time">{sl.time}</span>
                  <b class="sched-title">{sl.title}</b>
                  {sl.note && <span class="sched-note">{sl.note}</span>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
    <div class="wrap"><p class="muted" style="margin:22px 0 0;font-size:13px;">Times are the base rhythm; schools add their own lectures, work duties and outreach prep around it.</p></div>
  </section>


  <section class="sec cl-food" id="food">
    <div class="wrap">
      <div class="cl-food-grid">
        <figure class="cl-food-photo wipe">
          <div class="parslow" style="height:116%;margin-top:-8%;">
            <img src="/images/campus/food-prep.jpg" alt="Khmer women in blue preparing sticky rice in bamboo and palm-leaf wrapped food at a market table" loading="lazy" decoding="async" style="object-position:50% 60%;" />
          </div>
        </figure>
        <div class="cl-food-copy linein">
          <p class="eyebrow">Food</p>
          <h2 class="disp" style="margin:14px 0 0;font-size:clamp(30px,3.8vw,50px);font-weight:500;line-height:1.08;">Khmer culture happens around food.</h2>
          <p class="body" style="margin:18px 0 0;max-width:50ch;">Nobody here eats alone. The first question you will be asked every day is whether you have eaten yet — and it is a real question. Meals are shared, rice is the centre of every one of them, and fruit appears whenever people gather.</p>
          <p class="body" style="margin:14px 0 0;max-width:50ch;">Expect fish amok, sour soups, grilled everything, greens you cannot name yet, and a lot of chilli you are allowed to leave on the side.</p>
        </div>
      </div>

      <div class="card cl-cafe reveal io-in">
        <figure class="cl-cafe-photo">
          <img src="/images/campus/gp-cafe-sign.jpg" alt="The YWAM sign and the GP Cafe sign hanging among green leaves, with an iced green drink held up in front" loading="lazy" decoding="async" />
        </figure>
        <div class="cl-cafe-copy">
          <p class="eyebrow">On campus</p>
          <h3 class="disp" style="margin:12px 0 0;font-size:clamp(26px,3vw,40px);font-weight:500;line-height:1.1;">GP Cafe</h3>
          <p class="body" style="margin:16px 0 0;max-width:46ch;">Our own café, right on campus. Khmer coffee, iced drinks and something sweet, made by our community for our community and the neighbourhood around us. It is where conversations that start in class carry on.</p>
          <p class="muted" style="margin:14px 0 0;font-size:14px;">Open to students, staff, teams and neighbours.</p>
        </div>
        <figure class="cl-cafe-barista">
          <img src="/images/campus/gp-cafe-barista.jpg" alt="A smiling barista in an apron behind the GP Cafe counter, flashing a peace sign" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;">
    <div class="wrap">
      <p class="eyebrow reveal">Who lives here</p>
      <div class="cl-who stag" style="margin-top:22px;">
        {WHO.map(([t, d]) => (
          <div class="card cl-who-card">
            <h3 class="disp" style="margin:0;font-size:20px;font-weight:500;">{t}</h3>
            <p class="body" style="margin:12px 0 0;font-size:15px;">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <Cta
    title="Come and live it."
    body="Whether you are coming for a school, to volunteer, to join staff or with a team, this is the community you are walking into."
    primary={['apply', 'Apply']}
    secondary={['visit', 'Bring a team']}
  />
  <Footer />
</SrLayout>

<script>
  // Counters tick up when the stats strip comes into view, the schedule and
  // facilities strips get arrow buttons, and the Explore Siem Reap ride runs.
  let ctrl = null;
  const init = () => {
    if (ctrl) ctrl.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const counters = [...document.querySelectorAll('[data-count]')];
    if (counters.length) {
      const run = (el) => {
        const target = Number(el.dataset.count);
        if (reduce) { el.textContent = String(target); return; }
        const t0 = performance.now();
        const dur = 1200;
        const tick = (now) => {
          const t = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(target * e));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { run(en.target); io.unobserve(en.target); } });
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
      signal.addEventListener('abort', () => io.disconnect());
    }

    // Arrow buttons for the horizontal strips (schedule, facilities).
    document.querySelectorAll('[data-hs]').forEach((hs) => {
      const key = hs.dataset.hs;
      const track = hs.querySelector('.cl-hs-track');
      const step = () => { const first = track.firstElementChild; return first ? first.getBoundingClientRect().width + 18 : 320; };
      document.querySelectorAll(`[data-hs-prev="${key}"]`).forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }), { signal }));
      document.querySelectorAll(`[data-hs-next="${key}"]`).forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }), { signal }));
    });

    // Explore Siem Reap: the card flips up over the statement as the section
    // enters, then the view through the tuk-tuk swaps between places while
    // the frame stays put. Plate 0 is the real road; plates 1..n are places.
    const ride = document.querySelector('.ride-stack');
    if (!ride) return;
    const rpin = ride.querySelector('.ride-pin');
    const card = ride.querySelector('.ride-card');
    const plates = [...ride.querySelectorAll('.ride-plate')];
    const frame = ride.querySelector('.ride-frame');
    const intro = ride.querySelector('.ride-intro');
    const stops = [...ride.querySelectorAll('.ride-stop')];
    const marks = [...ride.querySelectorAll('.ride-mark')];
    if (reduce) { ride.classList.add('is-static'); return; }
    const lite = window.matchMedia('(max-width: 760px), (pointer: coarse)').matches;
    const clamp01 = (v) => Math.min(1, Math.max(0, v));
    const ease = (t) => t * t * (3 - 2 * t);
    const ramp = (t, a, b) => clamp01((t - a) / (b - a));
    const N = stops.length;             // places + good to know
    const INTRO = 0.14;                 // share of the pin spent on the intro
    const L = (1 - INTRO) / N;
    const update = () => {
      const vh = rpin.offsetHeight;
      const rect = ride.getBoundingClientRect();
      // Entry: the section's top travels from the bottom of the screen to the top.
      const entry = ease(clamp01(1 - rect.top / vh));
      card.style.transform = `rotateX(${((1 - entry) * 38).toFixed(2)}deg) scale(${(0.9 + 0.1 * entry).toFixed(3)})`;
      card.style.borderRadius = `${Math.round((1 - entry) * 28)}px`;
      const scrollable = rect.height - vh;
      const p = scrollable <= 0 ? 0 : clamp01(-rect.top / scrollable);
      const t = (p - INTRO) / L;        // < 0 during the intro, then 0..N across the stops

      plates.forEach((pl, k) => {
        let o;
        if (k === 0) o = Math.max(1 - ramp(t, -0.15, 0.05), ramp(t, N - 1 - 0.15, N - 1 + 0.05));
        else { const j = k - 1; o = Math.min(ramp(t, j - 0.15, j + 0.05), 1 - ramp(t, j + 0.85, j + 1.05)); }
        const j = k === 0 ? (t < 0 ? -1 : N - 1) : k - 1;
        const drive = clamp01((t - j + 0.15) / 1.2);
        pl.style.opacity = o.toFixed(3);
        pl.style.transform = `scale(${(1.03 + 0.1 * drive).toFixed(3)})`;
        if (!lite) pl.style.filter = o > 0 && o < 1 ? `blur(${((1 - o) * 5).toFixed(1)}px)` : '';
      });

      intro.style.opacity = String(1 - ramp(t, -0.45, -0.1));
      intro.style.transform = `translateY(calc(-50% - ${(ramp(t, -0.45, -0.1) * 30).toFixed(1)}px))`;

      stops.forEach((st, j) => {
        const inn = ramp(t, j + 0.04, j + 0.2);
        const out = j === N - 1 ? 0 : ramp(t, j + 0.8, j + 0.94);
        const o = ease(inn) * (1 - out);
        st.style.opacity = o.toFixed(3);
        st.style.transform = `translateY(${((1 - ease(inn)) * 26 - out * 18).toFixed(1)}px)`;
        st.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
      });

      const active = t < 0 ? 0 : Math.min(marks.length - 1, Math.floor(t) + 1);
      marks.forEach((mk, i) => { mk.classList.toggle('is-on', i === active); mk.classList.toggle('is-past', i < active); });

      // A gentle bob, as if on the road.
      frame.style.transform = `translateY(${(Math.sin(p * 90) * 2.2).toFixed(2)}px)`;
    };
    let raf = 0;
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { signal });
    update();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import { existsSync } from 'node:fs';
import SrLayout from '../layouts/SrLayout.astro';
import Footer from '../components/sr/Footer.astro';
import PageHead from '../components/sr/PageHead.astro';
import Cta from '../components/sr/Cta.astro';
import PhotoSlot from '../components/sr/PhotoSlot.astro';

// The campus photo goes at public/images/campus/campus.jpg; until it lands
// the hero falls back to the GonPreah community photo.
const CAMPUS_PHOTO = existsSync('public/images/campus/campus.jpg') ? '/images/campus/campus.jpg' : '/images/gonpreah-community.jpg';

const STATS: { n: number; suffix: string; label: string }[] = [
  { n: 40, suffix: '', label: 'full-time staff' },
  { n: 2, suffix: '', label: 'languages at every table' },
  { n: 1, suffix: '', label: 'campus, one family' },
  { n: 20, suffix: ' min', label: 'to Angkor Wat' },
];

// Living on the base. Draft copy for the team to correct — rhythms, rooms
// and rules are placeholders until staff confirm them.
const COMMUNITY: { km: string; title: string; body: string; photo?: string; alt?: string; label: string }[] = [
  { km: 'គ្រួសារ', title: 'Khmer and international, together', body: 'Forty staff and a changing family of students, volunteers and teams share this campus. Khmer is the first language and English is everywhere. You will learn a few words in your first week and be laughed at kindly for the rest.', label: 'Drop a photo — Khmer and international staff together' },
  { km: 'បាយ', title: 'We eat together', body: 'Meals are shared. Rice is the centre of every one of them. Expect fish, greens you cannot name yet, and a lot of chilli you can leave on the side.', label: 'Drop a photo — a shared meal' },
  { km: 'ថ្វាយបង្គំ', title: 'We worship together', body: 'Worship and prayer are part of the rhythm of the week — as a whole community, in schools, and in small groups. Some of it in Khmer, some in English, most of it both.', photo: '/images/gonpreah-worship-1.jpg', alt: 'Students worshipping together on the Siem Reap campus', label: '' },
  { km: 'បម្រើ', title: 'We work together', body: 'Everyone carries part of the load: cleaning, cooking, setting up, driving. Serving the community starts with serving each other.', label: 'Drop a photo — work duties on campus' },
];

const WHO: [string, string][] = [
  ['Students', 'DTS and DBS students live on campus for the length of their school, in shared rooms with classmates.'],
  ['Volunteers', 'Short or long term, volunteers live and eat with the community and join its rhythms while they serve.'],
  ['New staff', 'Staff joining us find their feet here first: language, community, city — before the work takes over.'],
  ['Teams', 'Visiting teams stay on or near the base, eat with us, and see what living here is actually like.'],
];

// Siem Reap for people who are coming to live here for a while, not just
// pass through. One panel per kind of day off, plus the practical one.
type Place = { name: string; note: string };
type Panel = { title: string; km: string; intro: string; places: Place[]; label: string };
const CITY: Panel[] = [
  {
    title: 'Temples & history', km: 'អង្គរ',
    intro: 'Siem Reap is the gateway to Angkor. The temples are twenty minutes from the base and you will want more than one visit.',
    places: [
      { name: 'Angkor Wat at sunrise', note: 'The one everyone comes for. Go early, stay for the quiet after the crowds leave.' },
      { name: 'Angkor Thom & the Bayon', note: 'The walled city and its temple of two hundred stone faces.' },
      { name: 'Ta Prohm', note: 'The temple the jungle took back — roots over stone.' },
      { name: 'Banteay Srei', note: 'Smaller, further out, and the finest carving in Angkor.' },
      { name: 'Angkor National Museum', note: 'Worth an afternoon before or after the temples themselves.' },
    ],
    label: 'Drop a photo — Angkor Wat',
  },
  {
    title: 'Food & cafés', km: 'ម្ហូប',
    intro: 'Khmer food is gentler than Thai — sour, herby, coconut-sweet. Learn three dishes and you will eat well anywhere.',
    places: [
      { name: 'Fish amok', note: 'Steamed fish curry in banana leaf. Order it your first week.' },
      { name: 'Num banh chok', note: 'Khmer noodles for breakfast, from a lady with a basket, before 9am.' },
      { name: 'Old Market (Psar Chas)', note: 'Fruit, fabric, coffee, everything. Bargain gently.' },
      { name: 'Kandal Village', note: 'Small streets of cafés and shops a short walk from the river.' },
      { name: 'Night markets & Pub Street', note: 'Loud, bright, cheap, and a good place to take a visiting team for one evening.' },
    ],
    label: 'Drop a photo — a market or café',
  },
  {
    title: 'Nature & day trips', km: 'ធម្មជាតិ',
    intro: 'When you need space, the countryside starts ten minutes out of town.',
    places: [
      { name: 'Tonlé Sap floating villages', note: 'Kampong Phluk or Kampong Khleang — stilt houses and flooded forest, best in the wet season.' },
      { name: 'Phnom Kulen', note: 'Waterfalls, a reclining Buddha, and the river of a thousand lingas. A full day.' },
      { name: 'Countryside by bicycle', note: 'Rice fields, water buffalo and villages on the road out of town.' },
      { name: 'Sunset from Pre Rup', note: 'Or Phnom Bakheng — both inside the Angkor park.' },
    ],
    label: 'Drop a photo — Tonlé Sap or Kulen',
  },
  {
    title: 'Culture & evenings', km: 'វប្បធម៌',
    intro: 'Siem Reap has more going on after dark than any city its size in Cambodia.',
    places: [
      { name: 'Phare, the Cambodian Circus', note: 'Acrobatics and storytelling by young Khmer performers. Take everyone.' },
      { name: 'Apsara dance', note: 'Classical Khmer dance, usually with dinner.' },
      { name: 'Made in Cambodia market', note: 'Local makers, fair prices, good gifts to send home.' },
      { name: 'Local churches', note: 'Khmer and international congregations — ask staff where they worship on Sundays.' },
    ],
    label: 'Drop a photo — Phare or an evening out',
  },
];

const PRACTICAL: [string, string][] = [
  ['Getting around', 'Tuk-tuks are everywhere; use the PassApp or Grab apps for a fair fixed price. Bicycles work well in town. Traffic is calmer than Phnom Penh, but still look twice.'],
  ['Money', 'US dollars and Khmer riel are both used. Small change comes back in riel (roughly 4,000 to the dollar). ATMs are common; most give dollars.'],
  ['Phone & internet', 'Buy a local SIM on arrival — Smart, Cellcard and Metfone all work. Data is cheap and the campus has wifi.'],
  ['Weather', 'Cool and dry from November to February, hot from March to May, wet from June to October. The rain comes hard and leaves fast.'],
  ['Dress', 'Cover shoulders and knees at temples and in villages. Light and modest is right almost everywhere.'],
  ['Health', 'Drink bottled or filtered water. Pharmacies and international clinics are in town; staff will point you to the ones we use.'],
];
---
<SrLayout title="Campus Life | YWAM Siem Reap" spacer={false}
  description="What living at YWAM Siem Reap is like — Khmer and international, students, volunteers, staff and teams in one community — and what to do in Siem Reap when the day is done.">
  <PageHead eyebrow="Campus life" km="ជីវិតសហគមន៍" title="Live in community. Love the city." highlight="Love the city."
    lead="Students, volunteers, new staff and teams all share one campus, one table and one city. Here is what that is like."
    photo={CAMPUS_PHOTO} full photoAlt="The YWAM Siem Reap campus" />

  <section class="cl-stats" aria-label="Campus in numbers">
    <div class="wrap cl-stats-grid">
      {STATS.map((s) => (
        <div class="cl-stat">
          <p class="disp cl-stat-n"><span data-count={s.n}>0</span>{s.suffix}</p>
          <p class="muted cl-stat-l">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec cl-community" style="padding-bottom:0;">
    <div class="wrap">
      <div class="reveal" style="max-width:62ch;">
        <p class="eyebrow">Living in community</p>
        <h2 class="disp" style="margin:14px 0 0;font-size:clamp(30px,3.8vw,50px);font-weight:500;line-height:1.08;">One family, two languages.</h2>
        <p class="body" style="margin:18px 0 0;">Community is not a programme here; it is the way the base works. You will live closer to more people than you are used to, and most people say it is the part they miss most when they leave.</p>
      </div>
    </div>
    <div class="cl-rows">
      {COMMUNITY.map((c, i) => (
        <div class={`cl-row${i % 2 ? ' cl-row--flip' : ''}`}>
          <p class={`km cl-row-km ${i % 2 ? 'driftback' : 'drift'}`} aria-hidden="true">{c.km}</p>
          <div class="wrap cl-row-grid">
            <figure class="cl-photo wipe">
              <div class="parslow" style="height:116%;margin-top:-8%;">
                {c.photo ? <img src={c.photo} alt={c.alt ?? ''} loading="lazy" decoding="async" /> : <PhotoSlot label={c.label} radius={0} />}
              </div>
            </figure>
            <div class="cl-copy linein">
              <p class="disp" style="margin:0;font-size:13px;letter-spacing:.14em;color:var(--sr-pink);">{'0' + (i + 1)}</p>
              <h3 class="disp" style="margin:12px 0 0;font-size:clamp(24px,2.8vw,38px);font-weight:500;line-height:1.1;">{c.title}</h3>
              <span class="rule growrule" style="margin:18px 0 0;transform-origin:left;"></span>
              <p class="body" style="margin:18px 0 0;max-width:46ch;">{c.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <p class="eyebrow reveal">Who lives here</p>
      <div class="cl-who stag" style="margin-top:22px;">
        {WHO.map(([t, d]) => (
          <div class="card cl-who-card">
            <h3 class="disp" style="margin:0;font-size:20px;font-weight:500;">{t}</h3>
            <p class="body" style="margin:12px 0 0;font-size:15px;">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="city-stack" id="siem-reap" aria-label="Things to do in Siem Reap">
    <div class="city-pin">
      <div class="wrap city-head">
        <div>
          <p class="eyebrow">Siem Reap</p>
          <h2 class="disp" style="margin:12px 0 0;font-size:clamp(28px,3.4vw,46px);font-weight:500;line-height:1.08;">The city is part of the training.</h2>
        </div>
        <div class="city-progress" aria-hidden="true">
          {[...CITY, { title: 'Good to know' }].map((p, i) => <span class="city-dot" data-i={i} title={p.title}></span>)}
          <span class="muted city-cue">Scroll →</span>
        </div>
      </div>
      <div class="city-track">
        {CITY.map((g, i) => (
          <article class="city-panel" data-i={i}>
            <p class="km city-panel-km" aria-hidden="true">{g.km}</p>
            <figure class="city-photo"><PhotoSlot label={g.label} radius={0} /></figure>
            <div class="city-copy">
              <p class="disp" style="margin:0;font-size:13px;letter-spacing:.14em;color:var(--sr-pink);">{'0' + (i + 1)} · {CITY.length + 1}</p>
              <h3 class="disp" style="margin:10px 0 0;font-size:clamp(24px,2.4vw,32px);font-weight:500;line-height:1.12;">{g.title}</h3>
              <p class="body" style="margin:12px 0 0;font-size:15px;">{g.intro}</p>
              <ul class="city-list">
                {g.places.map((p) => <li><b>{p.name}</b><span>{p.note}</span></li>)}
              </ul>
            </div>
          </article>
        ))}
        <article class="city-panel city-panel--practical" data-i={CITY.length}>
          <div class="city-copy">
            <p class="disp" style="margin:0;font-size:13px;letter-spacing:.14em;color:var(--sr-pink);">{'0' + (CITY.length + 1)} · {CITY.length + 1}</p>
            <h3 class="disp" style="margin:10px 0 0;font-size:clamp(24px,2.4vw,32px);font-weight:500;line-height:1.12;">Good to know</h3>
            <dl class="practical">
              {PRACTICAL.map(([k, v]) => (
                <div>
                  <dt class="disp" style="font-size:15px;font-weight:500;">{k}</dt>
                  <dd class="body" style="margin:6px 0 0;font-size:14px;">{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Cta
    title="Come and live it."
    body="Whether you are coming for a school, to volunteer, to join staff or with a team, this is the community you are walking into."
    primary={['apply', 'Apply']}
    secondary={['visit', 'Bring a team']}
  />
  <Footer />
</SrLayout>

<script>
  // Counters tick up when the stats strip comes into view; the Siem Reap
  // track slides horizontally with scroll while its section is pinned
  // (desktop only — on phones and reduced-motion the panels stack).
  let ctrl = null;
  const init = () => {
    if (ctrl) ctrl.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const counters = [...document.querySelectorAll('[data-count]')];
    if (counters.length) {
      const run = (el) => {
        const target = Number(el.dataset.count);
        if (reduce) { el.textContent = String(target); return; }
        const t0 = performance.now();
        const dur = 1200;
        const tick = (now) => {
          const t = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(target * e));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { run(en.target); io.unobserve(en.target); } });
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
      signal.addEventListener('abort', () => io.disconnect());
    }

    const stack = document.querySelector('.city-stack');
    const track = document.querySelector('.city-track');
    const dots = [...document.querySelectorAll('.city-dot')];
    const panels = [...document.querySelectorAll('.city-panel')];
    if (!stack || !track || !panels.length) return;
    const pinned = () => window.matchMedia('(min-width: 1001px) and (prefers-reduced-motion: no-preference)').matches;
    const update = () => {
      if (!pinned()) {
        track.style.transform = '';
        dots.forEach((d) => d.classList.remove('is-on'));
        return;
      }
      const rect = stack.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const p = scrollable <= 0 ? 0 : Math.min(1, Math.max(0, -rect.top / scrollable));
      const max = track.scrollWidth - track.parentElement.clientWidth;
      const eased = Math.min(1, Math.max(0, (p - 0.03) / 0.94));
      track.style.transform = `translateX(${(-eased * max).toFixed(1)}px)`;
      const idx = Math.min(panels.length - 1, Math.round(eased * (panels.length - 1)));
      dots.forEach((d, i) => d.classList.toggle('is-on', i <= idx));
      panels.forEach((pn, i) => pn.classList.toggle('is-on', i === idx));
    };
    let raf = 0;
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); };
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { signal });
    update();
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
